<?xml version="1.0" encoding="UTF-8"?>
<!-- Deep Candle accents for GtkSourceView 4 (the notes window).
     Text, background and selection follow the GTK theme. -->
<style-scheme id="deep-candle" name="Deep Candle" version="1.0">
  <author>Deep Candle</author>
  <description>Cursor, search and Markdown colors in the Deep Candle palette</description>

  <style name="cursor"                   foreground="#F7B922"/>
  <style name="current-line"             background="#1E1218"/>
  <style name="search-match"             foreground="#140C10" background="#F7B922"/>
  <style name="bracket-match"            foreground="#FFF2E6" background="#9B59D0" bold="true"/>
  <style name="bracket-mismatch"         foreground="#FFF2E6" background="#F24732" bold="true"/>

  <style name="def:heading"              foreground="#F7B922" bold="true"/>
  <style name="def:strong-emphasis"      bold="true"/>
  <style name="def:emphasis"             italic="true"/>
  <style name="def:list-marker"          foreground="#9B59D0" bold="true"/>
  <style name="def:link-text"            foreground="#BB90DF"/>
  <style name="def:link-destination"     foreground="#8A7470"/>
  <style name="def:link-symbol"          foreground="#8A7470"/>
  <style name="def:inline-code"          foreground="#5DB8A6"/>
  <style name="def:preformatted-section" foreground="#5DB8A6"/>
  <style name="def:thematic-break"       foreground="#8A7470"/>
  <style name="def:shebang"              foreground="#8A7470"/>
</style-scheme>
