#!/bin/sh
# sound-server: PipeWire for this session, where nothing else starts it. With systemd (Arch),
# systemd does: this does nothing. Without (Artix), Hyprland starts this (hyprland.lua, at its
# end): pipewire, then its session manager (wireplumber) and its PulseAudio side (pipewire-pulse:
# pactl, browsers, mpv). When Hyprland ends the session, all three end.
[ -d /run/systemd/system ] && exit 0                   # systemd runs this computer: its job
pgrep -u "$(id -u)" -x pipewire >/dev/null && exit 0   # one already runs: leave it
pipewire & p=$!
sleep 1                                                # pipewire ready before the other two
wireplumber & w=$!
pipewire-pulse & q=$!
trap 'kill $p $w $q 2>/dev/null' EXIT INT TERM
wait
