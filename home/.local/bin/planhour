  split("Nisan Iyar Sivan Tammuz Av Elul Tishrei Cheshvan Kislev Tevet Shevat Adar", HMON, " ")
  split("Heh Vav Zayin Chet Tet Yod Lamed Nun Samekh Ayin Tzadi Qof", HLET, " ")
  split("PM2.5 PM10 NO2 ozone", AIRN, " ")                     # the air's pollutants, as shown
}
$1 == "n" { N[$2] = $3; next }
$1 == "t" { T[$2] = $3; if ($3 >= 0) Q[++nq] = $2; next }
$1 == "f" { F[Q[++fq]] = substr($0, 3); next }
END {
  # (a key is asked for only where it is there: awk makes any key it's asked for, and the raw list
  # would show it, empty)
  WDAY = N["wday"] + 1; DR = RUL[WDAY] - 1; POLAR = ("polar" in N)
  DAY = CH[DR + 1]; CUR = POLAR ? -1 : N["hour"]; HOUR = POLAR ? "" : CH[(DR + CUR) % 7 + 1]
  LEFT = POLAR ? 0 : int((T["b" (CUR + 1)] - NOW + 59) / 60)
  NOSUN = "the Sun doesn\x27t " (N["noonalt"] < 0 ? "rise" : "set") " here today"
  dec = N["decan"]; DECR = CH[(2 + dec) % 7 + 1]; TIT = "Lord of " TITLE[dec + 1]
  nd = (dec + 1) % 36
  QS = N["season"]; if (LAT < 0) QS = (QS + 2) % 4            # the seasons of this hemisphere
  if (MODE == "raw") {
    for (k in N) printf "%s=%s\n", k, N[k]
    for (k in T) printf "%s=%s%s\n", k, T[k], (k in F ? " (" F[k] ")" : "")
    exit
  }
  if (MODE == "line") {
    if (POLAR) printf "day of %s \xc2\xb7 no planetary hours: %s%s\n", the(DAY), NOSUN, PLACE == "" ? "" : " \xc2\xb7 " PLACE
    else printf "day of %s \xc2\xb7 hour of %s \xc2\xb7 %d min left%s\n", the(DAY), the(HOUR), LEFT, PLACE == "" ? "" : " \xc2\xb7 " PLACE
    exit
  }
  if (MODE == "bar") {
    if (POLAR) print "- none 3600"
    else printf "%s %s %d\n", G[HOUR], HOUR, T["b" (CUR + 1)] - NOW
    exit
  }
  # ---- the popup: a label column 8 wide, then the text; the tables in columns 18 wide. Only ASCII
  # stands before a column that has to line up: the planets' glyphs, degrees and dots come from
  # whatever font has them, at that font's width, so they sit where nothing after them aligns
  L = 8; CW = 18
  S = dim("  \xc2\xb7  ")                              # between the parts of a line
  place()
  print ""
  # ---- the zodiac, when it isn't the usual one
  if (ZOD == "regulus") print label("Zodiac") "sidereal, from Regulus" dim(" at 0\xc2\xb0 Leo: the signs, decans and mansions")
  # ---- the day (with the Hebrew date, which turns at sunset) and the hour
  hebrew(N["today"] + 719163 + (has("set") && NOW >= T["set"]))
  j = HM > 12 ? 12 : HM; m = HM == 12 && hleap(HY) ? "Adar I" : HM == 13 ? "Adar II" : HMON[j]
  print label("Day") "<b>" pc(DAY, G[DAY] " " DAY) "</b>" S dim(WD[WDAY]) S HD " " m " " HY dim(" (" HLET[j] ", " SIGN[j] ")")
  if (POLAR) print label("Hour") dim("none: the Sun doesn\x27t " (N["noonalt"] < 0 ? "rise" : "set") " today, so no unequal hours or tattva tide")
  else hour()
  notice()
  print ""
  if (!POLAR) {
    # ---- the 24 hours in four columns: from sunrise, from true noon (where the 7th hour of the day
    # starts, give or take a minute), from sunset, from midnight (the 7th of the night)
    print label("Hours") dim(pad("day", 2 * CW) "night")
    for (h = 0; h < 6; h++) print sp(L) pad(cell(h), CW) pad(cell(h + 6), CW) pad(cell(h + 12), CW) cell(h + 18)
    print ""
  }
  sun_moon()
}
# the place (the weather's city): its name and country, its latitude and longitude, its altitude;
# its zone, its local mean time (the clock of its longitude) and the sundial's (the true Sun: the
# mean time and the equation of time); its air; away from home, the time there (all the times
# below are its own; until its forecast is saved, they are your zone's) and how far it is
function place(   c, s, z, a, d, f1, f2, x, lmt) {
  c = ENVIRON["W_CITY"]; gsub(/&/, "\\&amp;", c); gsub(/</, "\\&lt;", c); gsub(/>/, "\\&gt;", c)
  s = label("Place") (c == "" ? "" : "<b>" c "</b>" S) dms(LAT, "N", "S") " " dms(LON, "E", "W")
  if (ENVIRON["W_ELEV"] != "") s = then(s, dim("altitude ") rnd(ENVIRON["W_ELEV"]) dim(" m"))
  print s
  a = substr(OFF, 2, 2) + 0; d = substr(OFF, 4, 2)
  z = ENVIRON["W_TZ"]; z = (z == "" ? "" : z dim(", ")) (ABBR ~ /^[A-Z]+$/ && ABBR != "UTC" ? ABBR dim(", ") : "") \
      "UTC" (a == 0 && d == "00" ? "" : substr(OFF, 1, 1) a (d == "00" ? "" : ":" d))
  lmt = fmod(NOW + LON * 240, 86400)
  print then(then(sp(L) z, dim("local mean time ") clock(lmt)), dim("sundial ") clock(lmt + N["eot"] * 60))
  air()
  if (PLACE == "") return
  f1 = rad(LAT); f2 = rad(HLAT)                        # how far from home, on the great circle
  x = sin((f2 - f1) / 2) ^ 2 + cos(f1) * cos(f2) * sin(rad(HLON - LON) / 2) ^ 2
  print then(sp(L) (ZONE != "" ? HERE dim(" there, as are all the times below") : dim("times in your own zone until its forecast is saved")), \
             km(2 * 6371 * atan2(sqrt(x), sqrt(1 - x))) dim(" km from home"))
}
# the air this hour: its quality (the European index's band, and in brackets the index; gold from
# moderate, red from poor, and so too the pollutant that makes it), then each pollutant in
# micrograms a cubic metre
function air(   v, a, c, i, m, s, p) {
  if (split(ENVIRON["W_AIR"], v, " ") < 9 || v[1] == "null") return
  a = v[1] + 0; c = a < 40 ? "" : a < 60 ? "#F7B922" : "#F4604D"
  s = (a < 20 ? "good" : a < 40 ? "fair" : a < 60 ? "moderate" : a < 80 ? "poor" : a < 100 ? "very poor" : "extremely poor")
  s = sp(L) dim("air quality ") (c == "" ? s dim(" (") rnd(a) dim(")") : col(c, s " (" rnd(a) ")"))
  m = 2; for (i = 3; i <= 5; i++) if (v[i + 4] != "null" && v[i + 4] + 0 > v[m + 4] + 0) m = i
  p = ""
  for (i = 2; i <= 5; i++)
    if (v[i] != "null") p = p (p == "" ? "" : dim(", ")) (c != "" && i == m ? col(c, AIRN[i - 1] " " rnd(v[i])) : dim(AIRN[i - 1] " ") rnd(v[i]))
  print p == "" ? s : then(s, p dim(" \xc2\xb5g/m\xc2\xb3"))
}
function rad(d) { return d * 3.14159265358979 / 180 }
function rnd(x) { return sprintf("%d", x < 0 ? x - 0.5 : x + 0.5) }
function clock(s) { s = fmod(s, 86400); return sprintf("%02d:%02d", int(s / 3600), int((s % 3600) / 60)) }
# a latitude or longitude in degrees and minutes: 50\xc2\xb005\xe2\x80\xb2N
function dms(x, p, n,   h, d, m) {
  h = x < 0 ? n : p; if (x < 0) x = -x
  d = int(x); m = int((x - d) * 60 + 0.5); if (m == 60) { d++; m = 0 }
  return d "\xc2\xb0" sprintf("%02d", m) "\xe2\x80\xb2" h
}
# s, then part after a dot; a part that would run past the 78th column starts a new line
function then(s, part,   l, i) {
  l = s; while ((i = index(l, "\n")) > 0) l = substr(l, i + 1)
  return vlen(l) + 5 + vlen(part) > 78 ? s "\n" sp(L) part : s S part
}
# the hour: its planet, where it is and how it stands, its names on the Tree; the tattva now
function hour(   lon, g, mv, sb, f, k, n) {
  print label("Hour") pc(HOUR, G[HOUR] " " HOUR) S LEFT dim(" min left")
  # ---- the hour's planet: where it is and how it stands; its names on the Tree
  lon = HOUR == "Sun" ? N["sunlon"] : HOUR == "Moon" ? N["moonlon"] : N[HOUR "_lon"]
  g = dignity(HOUR, int(lon / 30))
  mv = (HOUR == "Sun" || HOUR == "Moon") ? "" : N[HOUR "_sta"] ? (N[HOUR "_mot"] < 0 ? "turning retrograde" : "turning direct") : N[HOUR "_mot"] < 0 ? "retrograde" : ""
  sb = HOUR == "Sun" ? "" : beams(lon - N["sunlon"])
  print also(also(also(sp(L) dim("in ") dsign(lon), g), mv), sb)
  # its Sephira, and there its names in three worlds: the divine name, the archangel, the choir
  split(SEPH[HOUR], f, "|")
  print sp(L) f[1] dim(", " f[2])
  print sp(L) f[3] S f[4] S f[5] dim(", " f[6])
  # ---- the tattva of the tide now, and the next
  k = N["tattva"] + 1; n = N["tattva_next"] + 1
  print label("Tattva") col(TATC[k], TAT[k]) dim(" (" TATW[k] ") until ") hm("tattva_end") S dim("then ") col(TATC[n], TAT[n])
}
# the notice: for a day after the Sun enters a decan, or a season, a line in gold
function notice(   new, snew, d, same) {
  new = NOW - T["decan_in"] < 86400; snew = has("season_in") && NOW - T["season_in"] < 86400
  d = snew ? T["season_in"] - T["decan_in"] : 0; same = new && snew && d < 60 && d > -60     # tropical: one event
  if (new) print sp(L) gold("the Sun entered " decname(dec) " " when("decan_in") (same ? ", the " EVENT[QS + 1] : ""))
  if (snew && !same) print sp(L) gold("the " EVENT[QS + 1] " " when("season_in"))
}
# the Sun, the Moon, the seven, the decan and the season
function sun_moon(   d, e, ph, i, r, s, x, k, f, a1, a2, v, vb, pl, p, lon, nr, dd, hh, new) {
  new = NOW - T["decan_in"] < 86400
  # ---- the Sun: rise, noon and set, and where; midnight; the day; where it is now; the twilights,
  # the blue and the golden hour
  print label("Sun") (has("rise") ? dim("rise ") hm("rise") : dim("no rise today")) (has("rise") ? dim(sprintf(", %d\xc2\xb0 %s", N["riseaz"] + 0.5, compass(N["riseaz"]))) : "") \
        S dim("noon ") hm("noon") dim(sprintf(", %d\xc2\xb0 %s", (N["noonalt"] < 0 ? -N["noonalt"] : N["noonalt"]) + 0.5, N["noonalt"] < 0 ? "below" : "high")) \
        S (has("set") ? dim("set ") hm("set") : dim("no set today")) (has("set") ? dim(sprintf(", %d\xc2\xb0 %s", N["setaz"] + 0.5, compass(N["setaz"]))) : "")
  if (("daylen" in N) && ("daylen0" in N)) { d = N["daylen"] - N["daylen0"]; d = d < 0 ? int(d - 0.5) : int(d + 0.5) }
  print sp(L) dim("midnight ") hm("midnight") \
        (!("daylen" in N) ? "" : S dim("day ") hmin(N["daylen"]) (!("daylen0" in N) ? "" : dim(d == 0 ? ", as yesterday" : ", " mins(d) (d < 0 ? " shorter" : " longer")))) \
        S dim("now ") sky(N["sunalt"], N["sunaz"])
  print sp(L) dim(pad("twilight", CW) pad("morning", CW) "evening")
  tw("astronomical", "m18", "", "e18", "")
  tw("nautical", "m12", "", "e12", "")
  tw("civil", "m6", "", "e6", "")
  tw("blue hour", "m8", "m4", "e4", "e8")
  tw("golden hour", "m4", "mp6", "ep6", "e4")
  print ""
  # ---- the Moon: where, its phase; rise and set, where it is now, how far; its mansion; the next
  # quarters; the next perigee and apogee
  e = N["elong"]; ph = ""
  for (i = 1; i <= 4; i++) if (ymd("qt" i) == TODAY) ph = gold(QN[N["q" i] + 1] " today")
  if (ph == "" && has("qprev") && ymd("qprev") == TODAY) ph = gold(QN[N["qp"] + 1] " today")
  if (ph == "") ph = (e < 180 ? "waxing" : "waning") " " (e < 90 || e >= 270 ? "crescent" : "gibbous")
  print label("Moon") dsign(N["moonlon"]) S ph S sprintf("%d%%", N["illum"] * 100 + 0.5) dim(" lit") \
        S sprintf("%.1f", (NOW - T["newprev"]) / 86400) dim(" days old")
  # void of course: from its last aspect in this sign (gold while it is) until it enters the next
  v = T["voc"]; vb = N["voc_body"] + 0
  print sp(L) (NOW >= v ? gold("void of course since " when("voc")) : dim("void of course from ") when("voc")) \
        dim(vb ? ", after its " ASPN[N["voc_asp"] + 0] " to " the(BODN[vb]) : ", all its time in the sign")
  print sp(L) dim("until it enters ") SIGN[N["moon_next"] + 1] " " when("moon_in")
  r = has("moonrise") ? dim("rise ") hm("moonrise") : dim("no rise today")
  s = has("moonset") ? dim("set ") hm("moonset") : dim("no set today")
  if (has("moonrise") && has("moonset") && T["moonset"] < T["moonrise"]) { x = r; r = s; s = x }   # in order
  print sp(L) r S s S dim("now ") sky(N["moonalt"], N["moonaz"]) S km(N["dist"]) dim(" km")
  k = int(N["moonlon"] * 28 / 360) + 1; split(MANS[k], f, "|")
  print sp(L) dim("mansion ") k " " f[1] (f[2] == "" ? "" : dim(", " f[2]))
  print sp(L) dim(f[3])
  for (i = 1; i <= 4; i += 2)
    print sp(L) pad(dim(QN[N["q" i] + 1]), CW) pad(when("qt" i), CW) pad(dim(QN[N["q" (i + 1)] + 1]), CW) when("qt" (i + 1))
  a1 = "perigee"; a2 = "apogee"; if (T["apogee"] < T["perigee"]) { a1 = "apogee"; a2 = "perigee" }
  print sp(L) pad(dim(a1), CW) pad(when(a1), CW) pad(dim(a2), CW) when(a2)
  print ""
  # ---- the seven where they are: the degree and the sign; retrograde, or turning (a station) today
  pl = ""
  for (i = 1; i <= 7; i++) {
    p = SEVEN[i]; lon = p == "Sun" ? N["sunlon"] : p == "Moon" ? N["moonlon"] : N[p "_lon"]
    pl = pl (i > 1 ? "  " : "") pc(p, G[p]) " " int(lon - 30 * int(lon / 30)) "\xc2\xb0" ZG[int(lon / 30) + 1] \
         (p == "Sun" || p == "Moon" ? "" : N[p "_sta"] ? dim(" st") : N[p "_mot"] < 0 ? " " dim(RX) : "")
  }
  print label("Planets") pl
  print ""
  # ---- the decan: the Sun in it since when (gold for a day), the next one when
  nr = CH[(2 + nd) % 7 + 1]
  print label("Decan") "<b>" decname(dec) "</b>" S pc(DECR, DECR) S card(dec) ", " TIT
  print sp(L) "Sun " at(N["sunlon"]) dim(", ") (new ? gold("since " when("decan_in")) : dim("since ") when("decan_in"))
  print sp(L) dim("next ") decname(nd) dim(", ") when("decan_next") S pc(nr, nr) S card(nd)
  # ---- the season
  dd = int((T["season_next"] - NOW) / 86400); hh = int((T["season_next"] - NOW) / 3600)
  print label("Season") SEASON[QS + 1] S EVENT[(QS + 1) % 4 + 1] " " when("season_next") \
        dim(dd >= 1 ? ", in " dd " day" (dd == 1 ? "" : "s") : ", in " hh " hour" (hh == 1 ? "" : "s"))
}
function tw(name, k1, k2, k3, k4) { print sp(L) pad(dim(name), CW) pad(span(k1, k2), CW) span(k3, k4) }
# a time, or a span of two; where the Sun doesn't get that low, the span runs on through the
# night: "until 04:52", "from 22:07"
function span(k1, k2) {
  if (k2 == "") return hm(k1)
  return has(k1) && has(k2) ? hm(k1) "\xe2\x80\x93" hm(k2) : has(k2) ? dim("until ") hm(k2) : has(k1) ? dim("from ") hm(k1) : "-"
}
