  -v LAT="$LAT" -v LON="$LON" -v HLAT="$HLAT" -v HLON="$HLON" -v ZOD="$ZODIAC" \
  -v PLACE="$PLACE" -v ZONE="$ZONE" -v HERE="$(date -d "@$NOW" +%H:%M)" -v OFF="$(date -d "@$NOW" +%z)" \
  -v ABBR="$(date -d "@$NOW" +%Z)" \
  -v TODAY="$(date -d "@$NOW" +%Y%m%d)" -v TOMORROW="$(date -d "@$((NOON + 86400))" +%Y%m%d)" \
  -v YESTERDAY="$(date -d "@$((NOON - 86400))" +%Y%m%d)" "$(cat <<'AWK'
# render: the sky's numbers as one line (MODE line), the raw values (raw) or the clock's
# popup (panel, Pango markup for rofi). Reads "n KEY VALUE", "t KEY SECONDS" and, for every
# time, "f HH:MM DOW DAY MON YYYYMMDD" in the same order, from date(1).
function floor(x) { return x == int(x) || x >= 0 ? int(x) : int(x) - 1 }
function the(p) { return p == "Sun" || p == "Moon" ? "the " p : p }
function col(c, s) { return "<span foreground=\x27" c "\x27>" s "</span>" }
function pc(p, s) { return col(C[p], s) }
function dim(s) { return col("#9A8683", s) }          # the theme's dim, a step lighter (5.6:1)
function gold(s) { return col("#F7B922", s) }
function sp(n,   s) { s = ""; while (n-- > 0) s = s " "; return s }
# visible width: tags dropped, every UTF-8 character counted once
function vlen(s,   n) { gsub(/<[^>]*>/, "", s); n = length(s); return n - gsub(/[\200-\277]/, "", s) }
function pad(s, w) { return s sp(w - vlen(s)) }
function has(k) { return (k in T) && T[k] >= 0 }
function hm(k) { return has(k) ? substr(F[k], 1, 5) : "-" }
# a date as a word where one fits: "today", "tomorrow", "yesterday", else "Mon 26 Oct"
function day(k,   a) {
  split(F[k], a, " ")
  return a[5] == TODAY ? "today" : a[5] == TOMORROW ? "tomorrow" : a[5] == YESTERDAY ? "yesterday" : a[2] " " a[3] " " a[4]
}
function when(k) { return has(k) ? day(k) " " substr(F[k], 1, 5) : "-" }     # "today 18:12"
function ymd(k,   a) { split(F[k], a, " "); return a[5] }
function at(lon,    s, d, m) {                      # 23 degrees 59 minutes Libra
  s = int(lon / 30); d = lon - 30 * s; m = int((d - int(d)) * 60)
  return sprintf("%d\xc2\xb0%02d\xe2\x80\xb2 %s", int(d), m, SIGN[s + 1])
}
function dsign(lon,   s) { s = int(lon / 30); return sprintf("%d\xc2\xb0 %s", int(lon - 30 * s), SIGN[s + 1]) }
function hmin(sec,   h, m) { sec = int(sec + 0.5); h = int(sec / 3600); m = int((sec - 3600 * h) / 60); return h "h " sprintf("%02d", m) "m" }
function mins(sec,   a, m, s) { a = sec < 0 ? -sec : sec; a = int(a + 0.5); m = int(a / 60); s = a - 60 * m; return (m ? m "m " : "") s "s" }
function km(x,   s, r) {                            # 403,517
  s = sprintf("%d", x + 0.5); r = ""
  while (length(s) > 3) { r = "," substr(s, length(s) - 2) r; s = substr(s, 1, length(s) - 3) }
  return s r
}
# where a body is now: its height in whole degrees, "high" or "below" (the horizon), and where:
# "29 degrees high, SE", "19 degrees below, W"
function sky(alt, az,   a) {
  a = int((alt < 0 ? -alt : alt) + 0.5)
  return a "\xc2\xb0" dim((alt < 0 && a > 0 ? " below, " : " high, ") compass(az))
}
function compass(az) { return CP[int(fmod(az + 11.25, 360) / 22.5) + 1] }
function fmod(a, b) { return a - b * floor(a / b) }
function decname(i,   s) { s = int(i / 3); return SIGN[s + 1] " " (i % 3 == 0 ? "I" : i % 3 == 1 ? "II" : "III") }
function card(i,   s) { s = int(i / 3); return (2 + 3 * (s % 3) + i % 3) " of " SUIT[s % 4 + 1] }
function cell(h,    t, p) {                         # one hour in the table: its start and ruler
  t = hm("b" h); p = CH[(DR + h) % 7 + 1]
  if (h < CUR) return dim(t " " p)
  if (h > CUR) return t " " pc(p, p)
  return "<b>" gold(t) " " pc(p, p) "</b>"
}
function label(s) { return dim(pad(s, L)) }         # a section's name, in the label column
# essential dignity of planet p in sign s (0 Aries .. 11 Pisces): Ptolemy's houses and exaltations
function dignity(p, s,   r) {
  if (index(" " DOM[p] " ", " " s " ")) r = "in its own sign"
  if (EXA[p] == s) r = (r == "" ? "" : r " and ") "exalted"
  if (index(" " DOM[p] " ", " " (s + 6) % 12 " ")) r = "in its detriment"
  if ((EXA[p] + 6) % 12 == s) r = (r == "" ? "in its fall" : r " and fall")
  return r
}
# a planet and the Sun, d degrees apart, as Lilly has it (Christian Astrology, 1647): within 17'
# cazimi, in the heart of the Sun, a strength; within 8 degrees 30' combust; within 17 degrees
# under the beams (older authors give 15)
function beams(d) {
  d = fmod(d + 180, 360) - 180; if (d < 0) d = -d
  return d <= 17 / 60 ? "cazimi" : d <= 8.5 ? "combust" : d <= 17 ? "under the beams" : ""
}
# s, then part after a comma; a part that would run past the 78th column starts a new line
function also(s, part,   l, i) {
  if (part == "") return s
  l = s; while ((i = index(l, "\n")) > 0) l = substr(l, i + 1)
  return vlen(l) + 2 + vlen(part) > 78 ? s dim(",") "\n" sp(L) part : s dim(", ") part
}
# the Hebrew calendar, as in Reingold and Dershowitz, Calendrical Calculations (days are R.D.:
# 1 is 1 January of the year 1; months from 1 Nisan to 12 Adar, 13 Adar II in a leap year)
function hleap(y) { return (7 * y + 1) % 19 < 7 }
function helapsed(y,   m, d) {
  m = int((235 * y - 234) / 19); d = 29 * m + int((12084 + 13753 * m) / 25920)
  return (3 * (d + 1)) % 7 < 3 ? d + 1 : d
}
function hnewyear(y,   a, b, c) {                 # 1 Tishrei of year y
  a = helapsed(y - 1); b = helapsed(y); c = helapsed(y + 1)
  return -1373427 + b + (c - b == 356 ? 2 : b - a == 382 ? 1 : 0)
}
function hmonthlen(m, y,   n) {
  if (m == 2 || m == 4 || m == 6 || m == 10 || m == 13 || (m == 12 && !hleap(y))) return 29
  n = hnewyear(y + 1) - hnewyear(y)
  if (m == 8) return n % 10 == 5 ? 30 : 29        # Cheshvan is long in years of 355 and 385 days
  if (m == 9) return n % 10 == 3 ? 29 : 30        # Kislev is short in years of 353 and 383 days
  return 30
}
function hfirst(y, m,   r, i) {                   # the day of the 1st of month m in year y
  r = hnewyear(y)
  if (m < 7) { for (i = 7; i <= 12 + hleap(y); i++) r += hmonthlen(i, y); for (i = 1; i < m; i++) r += hmonthlen(i, y) }
  else for (i = 7; i < m; i++) r += hmonthlen(i, y)
  return r
}
function hebrew(rd,   y, m) {                     # sets HY HM HD
  for (y = int((rd + 1373427) / 365.25) + 1; hnewyear(y) > rd; y--) ;
  while (hnewyear(y + 1) <= rd) y++
  for (m = rd < hfirst(y, 1) ? 7 : 1; rd >= hfirst(y, m) + hmonthlen(m, y); m++) ;
  HY = y; HM = m; HD = rd - hfirst(y, m) + 1
}
