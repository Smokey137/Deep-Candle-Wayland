  NA = split(TA, rows, ";")
  for (i = 1; i <= NA; i++) {
    split(rows[i], f, " "); AD[i] = f[1]; AM[i] = f[2]; AMp[i] = f[3]; AF[i] = f[4]; AL[i] = f[5]; AR[i] = f[6]
    AE[i] = AM[i] < 0 ? -AM[i] : AM[i]                  # the power of E the term takes
  }
  NB = split(TB, rows, ";")
  for (i = 1; i <= NB; i++) {
    split(rows[i], f, " "); BD[i] = f[1]; BM[i] = f[2]; BMp[i] = f[3]; BF[i] = f[4]; BB[i] = f[5]
    BE[i] = BM[i] < 0 ? -BM[i] : BM[i]
  }
  for (name in V) {
    VN[name] = split(V[name], rows, ";")
    for (i = 1; i <= VN[name]; i++) { split(rows[i], f, " "); VA[name, i] = f[1]; VB[name, i] = f[2]; VC[name, i] = f[3] }
  }

  off = (substr(Z, 1, 1) == "-" ? -1 : 1) * (substr(Z, 2, 2) * 3600 + substr(Z, 4, 2) * 60)
  today = floor((NOW + off) / 86400)                    # the local date, in days since 1970

  # ---- the planetary day: from its sunrise; its 24 unequal hours
  r = sunalt(today, -0.833, 1)
  pd = (r >= 0 && r <= NOW) ? today : today - 1
  r = sunalt(pd, -0.833, 1); s = sunalt(pd, -0.833, 0); r2 = sunalt(pd + 1, -0.833, 1)
  out("n", "today", today)
  if (r < 0 || s < 0 || r2 < 0) {
    # the Sun doesn't rise or set (the polar night or day): no unequal hours, nor a tide from
    # sunrise; the day is the civil day, under its ruler, and the rest is as ever
    out("n", "polar", 1); out("n", "pday", today); out("n", "wday", fmod(today + 4, 7))
  } else {
    for (h = 0; h < 12; h++) { b[h] = r + h * (s - r) / 12; b[h + 12] = s + h * (r2 - s) / 12 }
    b[24] = r2
    for (cur = 0; cur < 23 && NOW >= b[cur + 1]; cur++) ;
    out("n", "pday", pd); out("n", "wday", fmod(pd + 4, 7)); out("n", "hour", cur)
    for (h = 0; h <= 24; h++) outt("b" h, b[h])
    # the tattva tide (the Golden Dawn's "The Tattwas of the Eastern School", in Regardie): from
    # sunrise Akasa, Vayu, Tejas, Apas, Prithivi, "each remaining one Ghari" (24 minutes), the round
    # of five in two hours, again and again until the next sunrise
    k = int((NOW - b[0]) / 1440); e = b[0] + (k + 1) * 1440
    out("n", "tattva", k % 5); out("n", "tattva_next", e < b[24] ? (k + 1) % 5 : 0); outt("tattva_end", e < b[24] ? e : b[24])
  }

  # ---- the Sun on the local date: rise, set, noon, twilights, blue and golden hour
  split("m18 -18 1|m12 -12 1|m8 -8 1|m6 -6 1|m4 -4 1|rise -0.833 1|mp6 6 1|" \
        "ep6 6 0|set -0.833 0|e4 -4 0|e6 -6 0|e8 -8 0|e12 -12 0|e18 -18 0", EV, "|")
  for (i = 1; i in EV; i++) { split(EV[i], f, " "); T_[f[1]] = sunalt(today, f[2], f[3]); outt(f[1], T_[f[1]]) }
  if (T_["rise"] >= 0) { sun(T_["rise"]); altaz(T_["rise"], SRA, SDEC); out("n", "riseaz", AZ) }
  if (T_["set"] >= 0) { sun(T_["set"]); altaz(T_["set"], SRA, SDEC); out("n", "setaz", AZ) }
  t = transit(today, 0); outt("noon", t); sun(t); altaz(t, SRA, SDEC); out("n", "noonalt", ALT)
  outt("midnight", transit(today, 1))
  r = sunalt(today - 1, -0.833, 1); s = sunalt(today - 1, -0.833, 0)
  if (T_["rise"] >= 0 && T_["set"] >= 0) out("n", "daylen", T_["set"] - T_["rise"])
  if (r >= 0 && s >= 0) out("n", "daylen0", s - r)
  sun(NOW); altaz(NOW, SRA, SDEC); out("n", "sunalt", ALT); out("n", "sunaz", AZ); out("n", "eot", SE)
  LS = fmod(SL - zshift(NOW), 360); out("n", "sunlon", LS); TROP = SL

  # ---- the decan: when the Sun entered it, when it enters the next
  dec = int(LS / 10)
  out("n", "decan", dec)
  outt("decan_in", sunreach(dec * 10, NOW - 15 * 86400, NOW, 0))
  outt("decan_next", sunreach(fmod((dec + 1) * 10, 360), NOW, NOW + 15 * 86400, 0))

  # ---- the season: the next equinox or solstice (always tropical), and the last one when it
  # was under a day and a bit ago (the Sun moves under 1.1 degrees in that time)
  q = int(TROP / 90); out("n", "season", q)
  outt("season_next", sunreach(fmod((q + 1) * 90, 360), NOW, NOW + 100 * 86400, 1))
  outt("season_in", TROP - 90 * q < 1.1 ? sunreach(90 * q, NOW - 2 * 86400, NOW, 1) : -1)

  # ---- the five planets: longitude, daily motion, and whether the motion turns within a day
  split("Saturn Jupiter Mars Venus Mercury", PL, " ")
  for (i = 1; i <= 5; i++) {
    l0 = plon(PL[i], NOW - 86400); l1 = plon(PL[i], NOW); l2 = plon(PL[i], NOW + 86400)
    m1 = wrap(l1 - l0); m2 = wrap(l2 - l1)
    out("n", PL[i] "_lon", fmod(l1 - zshift(NOW), 360)); out("n", PL[i] "_mot", m2)
    out("n", PL[i] "_sta", (m1 < 0) != (m2 < 0))
  }

  # ---- the Moon now: where, how lit, waxing or waning
  phase(NOW); out("n", "moonlon", fmod(ML - zshift(NOW), 360)); out("n", "elong", ELONG)
  out("n", "illum", ILLUM); out("n", "dist", MD)
  altaz(NOW, MRA, MDEC); out("n", "moonalt", ALT - MPAR * cos(rad(ALT))); out("n", "moonaz", AZ)   # (seen from here)

  # ---- the Moon's sign: when it came in, when it goes on to the next; void of course from its last
  # exact aspect in the sign (conjunction, sextile, square, trine or opposition) to the Sun or a
  # planet, Mercury to Saturn, until it leaves the sign; with no aspect in it, the whole sign. The
  # Moon is faster than all of them, so its distance from each only grows: an aspect is where that
  # passes a multiple of 60 or 90, found on a three-hour scan and halved down to a few seconds
  m0 = int(fmod(ML - zshift(NOW), 360) / 30)
  mi = mreach(fmod((m0 + 1) * 30, 360), NOW, 1); mo = mreach(m0 * 30, NOW, 0)
  out("n", "moon_next", (m0 + 1) % 12); outt("moon_in", mi)
  split("Sun Mercury Venus Mars Jupiter Saturn", BOD, " "); split("0 60 90 120 180 240 270 300", ASP, " ")
  voc = mo; vb = va = 0
  n = int((mi - mo) / 10800) + 1
  for (k = 0; k <= n; k++) {                     # the scan: the Moon and the six, every 3 hours
    st[k] = k < n ? mo + k * 10800 : mi; moon(st[k]); sm[k] = ML
    for (j = 1; j <= 6; j++) sb[k, j] = blon(BOD[j], st[k])
  }
  for (k = 1; k <= n; k++)
    for (j = 1; j <= 6; j++)
      for (a = 1; a <= 8; a++) {
        d1 = wrap(sm[k - 1] - sb[k - 1, j] - ASP[a]); d2 = wrap(sm[k] - sb[k, j] - ASP[a])
        if (d1 < 0 && d2 >= 0 && d2 - d1 < 90 && (t = aspect(j, ASP[a], st[k - 1], st[k])) > voc) { voc = t; vb = j; va = ASP[a] }
      }
  outt("voc", voc); out("n", "voc_body", vb); out("n", "voc_asp", va)

  # ---- the next four quarters, and the last new moon (for the age)
  e0 = ELONG; t1 = NOW; u1 = e0; n = 0
  for (k = 1; k <= 40 && n < 4; k++) {
    t2 = NOW + k * 86400; phase(t2); u2 = u1 + fmod(ELONG - fmod(u1, 360), 360)
    while (n < 4 && u2 >= (bnd = (int(e0 / 90) + n + 1) * 90)) {
      n++; out("n", "q" n, fmod(bnd, 360) / 90); outt("qt" n, moonreach(fmod(bnd, 360), t1, t2))
    }
    t1 = t2; u1 = u2
  }
  # the last new moon: back a day at a time until the elongation turns over, then halved down
  # (a month's span would hold the full moon too, where the halving can lose its way)
  t2 = NOW; u1 = e0
  for (k = 1; k <= 31; k++) { t1 = NOW - k * 86400; phase(t1); if (ELONG > u1) break; u1 = ELONG; t2 = t1 }
  outt("newprev", moonreach(0, t1, t2))
  pb = int(e0 / 90) * 90; out("n", "qp", pb / 90); outt("qprev", moonreach(pb, NOW - 9 * 86400, NOW))

  # ---- perigee and apogee: the next of each, a twice-daily scan from half a day back (so one in
  # the next hours isn't missed) over 33 days, refined; one already past is let go
  for (k = 0; k <= 66; k++) { moon(NOW + (k - 1) * 43200); dd[k] = MD }
  gotp = gota = 0
  for (k = 1; k < 66 && !(gotp && gota); k++) {
    t1 = NOW + (k - 2) * 43200; t2 = NOW + k * 43200
    if (!gotp && dd[k] < dd[k - 1] && dd[k] <= dd[k + 1] && apsis(t1, t2, 1) >= NOW) { gotp = 1; outt("perigee", APT); out("n", "perigee_km", APKM) }
    if (!gota && dd[k] > dd[k - 1] && dd[k] >= dd[k + 1] && apsis(t1, t2, -1) >= NOW) { gota = 1; outt("apogee", APT); out("n", "apogee_km", APKM) }
  }

  # ---- moonrise and moonset on the local date (20-minute scan, then bisection)
  mr = ms = -1; t1 = D0; f1 = moonup(t1)
  for (t2 = D0 + 1200; t1 < D1; t2 += 1200) {
    if (t2 > D1) t2 = D1
    f2 = moonup(t2)
    if (f1 < 0 && f2 >= 0 && mr < 0) mr = moonx(t1, t2, 1)
    if (f1 >= 0 && f2 < 0 && ms < 0) ms = moonx(t1, t2, 0)
    t1 = t2; f1 = f2
  }
  outt("moonrise", mr); outt("moonset", ms)
}
# the Moon's longitude in the zodiac (the chosen frame)
function moonlon(t) { moon(t); return fmod(ML - zshift(t), 360) }
# when the Moon reaches longitude b (zodiac frame): the first time after t (later 1), or the last
# time before it (later 0); it moves 11 to 15 degrees a day, so a sign takes under three days
function mreach(b, t, later,   ta, tb, i, m) {
  ta = tb = t
  for (i = 0; i < 16; i++) {
    if (later) { ta = tb; tb = ta + 21600; if (wrap(moonlon(tb) - b) >= 0) break }
    else { tb = ta; ta = tb - 21600; if (wrap(moonlon(ta) - b) < 0) break }
  }
  while (tb - ta > 1) { m = (ta + tb) / 2; if (wrap(moonlon(m) - b) < 0) ta = m; else tb = m }
  return (ta + tb) / 2
}
# the longitude of the Sun or a planet at t (of date)
function blon(name, t) { if (name == "Sun") { sun(t); return SL } return plon(name, t) }
# when, between ta and tb, the Moon stands asp degrees on from body j (an aspect, exact)
function aspect(j, asp, ta, tb,   m) {
  while (tb - ta > 5) {
    m = (ta + tb) / 2; moon(m)
    if (wrap(ML - blon(BOD[j], m) - asp) < 0) ta = m; else tb = m
  }
  return (ta + tb) / 2
}
# the time between ta and tb where the distance of the Moon is least (s 1) or greatest (s -1):
# APT, and the distance then, APKM
function apsis(ta, tb, s,   m1, m2, d1, d2) {
  while (tb - ta > 60) {
    m1 = ta + (tb - ta) / 3; m2 = tb - (tb - ta) / 3
    moon(m1); d1 = MD * s; moon(m2); d2 = MD * s
    if (d1 < d2) tb = m2; else ta = m1
  }
  APT = (ta + tb) / 2; moon(APT); APKM = MD
  return APT
}
# the moment between ta and tb where the Moon crosses its rising altitude, going up (up 1) or down
function moonx(ta, tb, up,   m) {
  while (tb - ta > 1) {
    m = (ta + tb) / 2
    if ((moonup(m) >= 0) == (up == 1)) tb = m; else ta = m
  }
  return (ta + tb) / 2
}
AWK
)")
case $SKY in
  '') echo "planhour: awk failed" >&2; exit 1 ;;
esac
# every time to local time in one date(1) call, rounded to the minute
TIMES=$(printf '%s\n' "$SKY" | awk '$1 == "t" && $3 >= 0 { print "@" ($3 + 30) }' | date -f - '+f %H:%M %a %-d %b %Y%m%d')
