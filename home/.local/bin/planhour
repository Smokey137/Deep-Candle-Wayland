#!/bin/sh
# planhour: the planetary hours, the Sun, the Moon and the planets, the tattva, the decan, the
# season and the Hebrew date, computed on this machine: no network, no location lookup.
# Part of the planetary-hours kit (planhour, hours).
#
#   planhour       one line: the day's ruler, the hour's ruler, time left in the hour
#   planhour -p    the clock's popup (Pango markup): the place (the weather's city: where on
#                  the Earth, how high, its zone, its mean time and the sundial's, its air); the day
#                  with its Hebrew date; the hour,
#                  where its planet stands, its Sephira and names; the tattva; the 24 hours;
#                  the Sun (rise, noon, set, midnight, the day, where it is now, twilights,
#                  blue and golden hour); the Moon (where, phase, its next sign and when it is
#                  void of course, rise, set, mansion, quarters, perigee, apogee); the seven
#                  where they are; the decan; the season
#   planhour -b    for the bar (hours bar): the hour's planet, its glyph and name, and the
#                  seconds left in the hour ("- none 3600" where the Sun neither rises nor sets)
#   planhour -r    the raw numbers, for checking
#
# Where the Sun doesn't rise or set (the polar night or day) there are no unequal hours, nor a
# tattva tide from sunrise: the day is the civil day under its ruler, and the rest is as ever.
#
# Unequal hours: sunrise to sunset in twelve, sunset to the next sunrise in twelve, in the
# Chaldean order from the day's ruler; the planetary day starts at sunrise. Sun: VSOP87 (the
# series of NREL's Solar Position Algorithm), Moon: Meeus, Astronomical Algorithms, ch. 47;
# both within a few arcseconds, so times come out within seconds (moon phases, decan and
# season within half a minute). Planets: Mercury, Venus and Mars from JPL's approximate elements
# (within an arcminute), Jupiter and Saturn from VSOP87 (IMCCE), truncated here (within 15
# arcseconds: their JPL elements are 5 arcminutes out, which would put the Moon's last aspect to
# them, and so its void of course, 10 minutes out).
# Twilights: astronomical -18, nautical -12, civil -6 degrees; blue hour -8 to -4, golden hour
# -4 to +6 (as Suntimes). Decans and their cards: the Golden Dawn's Book T. The Sephiroth and
# their names: the Golden Dawn (Regardie). The tattva tide: the Golden Dawn's "The Tattwas of
# the Eastern School", from sunrise one ghari (24 minutes) each, the round of five in two hours.
# The mansions: Agrippa, Occult Philosophy II.33.
# The hour's planet and the Sun: Lilly, Christian Astrology (cazimi within 17', combust within
# 8 degrees 30', under the beams within 17 degrees).
# The Hebrew calendar: Reingold and Dershowitz, Calendrical Calculations. Times are worked in
# UT and shown by date(1), so summer time costs nothing.
# Where: PLANHOUR_LAT and PLANHOUR_LON when both are set. Otherwise the city the weather shows
# (the one picked in its panel, else its home), and away from home that city's own time: the
# zone saved with the city, else the one named in its saved forecast; with no weather script,
# London (an example).
LAT=51.5074 LON=-0.1278 HLAT=51.5074 HLON=-0.1278 PLACE='' ZONE='' NAME=''
if [ -n "${PLANHOUR_LAT:-}" ] && [ -n "${PLANHOUR_LON:-}" ]; then
  LAT=$PLANHOUR_LAT LON=$PLANHOUR_LON
else
  T=$(printf '\t')
  home=$("$HOME/.local/bin/weather" home 2>/dev/null)
  here=$(head -n 1 "${XDG_CONFIG_HOME:-$HOME/.config}/weather/places" 2>/dev/null)
  case $here in *"$T"*"$T"?*) ;; *) here=$home ;; esac
  case $home in *"$T"*"$T"?*) HLAT=${home%%"$T"*}; h=${home#*"$T"}; HLON=${h%%"$T"*} ;; esac
  case $here in *"$T"*"$T"?*) LAT=${here%%"$T"*}; h=${here#*"$T"}; LON=${h%%"$T"*}; NAME=${h#*"$T"} ;; esac
  case $NAME in *"$T"*) ZONE=${NAME#*"$T"}; NAME=${NAME%%"$T"*} ;; esac      # the city's zone (weather 10)
  case $LAT$LON$HLAT$HLON in *[!0-9.-]*) LAT=51.5074 LON=-0.1278 HLAT=51.5074 HLON=-0.1278 ;; esac
  if awk -v a="$LAT" -v b="$LON" -v c="$HLAT" -v d="$HLON" 'BEGIN { exit !((a - c) ^ 2 + (b - d) ^ 2 >= 0.01) }'; then
    PLACE=${NAME%%,*}
    case $ZONE in *[!A-Za-z0-9_/+-]*|/*|*..*) ZONE='' ;; esac
    [ -n "$ZONE" ] || ZONE=$(sed -n 's/.*"timezone":"\([A-Za-z0-9_/+-]*\)".*/\1/p' \
                               "${XDG_CACHE_HOME:-$HOME/.cache}/weather/$LAT,$LON.json" 2>/dev/null)
    if [ -n "$ZONE" ] && [ -f "/usr/share/zoneinfo/$ZONE" ]; then export TZ="$ZONE"; else ZONE=''; unset TZ; fi
  else
    ZONE=''; unset TZ                       # at home: the computer's own zone
  fi
fi
# The place for the popup: the city and its country; its altitude, as the weather script saves it
# (Open-Meteo's elevation model, 90 m, at the city's coordinates); the zone the times are in
case $NAME in *,*) CITY="${NAME%%,*}, ${NAME##*, }" ;; *) CITY=$NAME ;; esac
ELEV=$(sed -n 's/.*"elevation":\[\(-\{0,1\}[0-9.]*\)\].*/\1/p' \
         "${XDG_CACHE_HOME:-$HOME/.cache}/weather/$LAT,$LON.elevation.json" 2>/dev/null | head -n 1)
TZNAME=${ZONE:-${TZ:-$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')}}
TZNAME=${TZNAME#:}
# The zodiac the signs, decans and mansions are counted in (the seasons are always tropical;
# Agrippa counts the mansions from the stars, which is what regulus does):
#   tropical  from the spring equinox, as modern decan practice dates the small cards
#   regulus   from Cor Leonis at 0 Leo, as Book T says: "the beginning of the Decanates is
#             from the royal Star of Leo, the great Star Cor Leonis" (sidereal; today about
#             30 degrees behind tropical)
ZODIAC=${PLANHOUR_ZODIAC:-tropical}
DT=69                            # TT - UT in seconds (2026; it changes by under a second a year)
NOW=${PLANHOUR_NOW:-$(date +%s)}
export LC_ALL=C

case ${1:-} in
  '')  MODE=line ;;
  -p)  MODE=panel ;;
  -b)  MODE=bar ;;
  -r)  MODE=raw ;;
  *)   echo "usage: planhour [-p | -b | -r]" >&2; exit 2 ;;
esac
case $ZODIAC in
  tropical|regulus) ;;
  *) echo "planhour: ZODIAC is tropical or regulus, not '$ZODIAC'" >&2; exit 2 ;;
esac
# The air this hour, as the weather script saves it with each forecast (Open-Meteo's, from CAMS;
# its hours in UT): the European index, PM2.5, PM10, NO2, ozone, and the index of each; nothing
# when none of its hours is now
AIR=$(awk -v NOW="$NOW" '
  function at(k, i,   v) {
    if (!match(J, "\"" k "\":\\[[^]]*\\]")) return "null"
    split(substr(J, RSTART + length(k) + 4, RLENGTH - length(k) - 5), v, ","); return v[i]
  }
  { J = J $0 }
  END {
    if (!match(J, /"time":\[[^]]*\]/)) exit
    n = split(substr(J, RSTART + 8, RLENGTH - 9), t, ",")
    for (i = 1; i <= n && !(t[i] <= NOW && NOW < t[i] + 3600); i++) ;
    if (i > n) exit
    print at("european_aqi", i), at("pm2_5", i), at("pm10", i), at("nitrogen_dioxide", i), at("ozone", i), \
          at("european_aqi_pm2_5", i), at("european_aqi_pm10", i), at("european_aqi_nitrogen_dioxide", i), \
          at("european_aqi_ozone", i)
  }' "${XDG_CACHE_HOME:-$HOME/.cache}/weather/$LAT,$LON.air.json" 2>/dev/null)

TODAY=$(date -d "@$NOW" +%Y-%m-%d)
# the day's bounds; where the clocks skip midnight for summer time (Havana, Beirut, Cairo, Santiago),
# the day starts at 01:00, and date(1) gets no 00:00 to take
NOON=$(date -d "$TODAY 12:00" +%s); NEXT=$(date -d "@$((NOON + 86400))" +%F)
D0=$(date -d "$TODAY 00:00" +%s 2>/dev/null || date -d "$TODAY 01:00" +%s)
D1=$(date -d "$NEXT 00:00" +%s 2>/dev/null || date -d "$NEXT 01:00" +%s)
SKY=$(awk -v LAT="$LAT" -v LON="$LON" -v NOW="$NOW" -v D0="$D0" -v D1="$D1" -v DT="$DT" \
          -v ZOD="$ZODIAC" -v Z="$(date -d "@$NOW" +%z)" "$(cat <<'AWK'
# sky: the planetary day and hours, the Sun (twilights, blue and golden hour, noon), the Moon
# (rise and set, phases, apsides), the planets, the tattva, the decan and the season, for planhour.
# In (-v): LAT LON (degrees, east +), NOW (seconds since 1970, UT), D0 D1 (the local day
# start and end), DT (TT - UT in seconds), ZOD (tropical or regulus).
# Out: "n KEY VALUE" for a number, "t KEY SECONDS" for a time (-1: does not happen).
# Sun: VSOP87 for the Earth, as truncated in the Solar Position Algorithm of NREL (about 1
# arcsecond). Moon: Meeus, Astronomical Algorithms, ch. 47, tables 47.A and 47.B in full
# (about 10 arcseconds). Rise, set and twilight as in Meeus ch. 15. Planets: JPL's approximate
# Keplerian elements for Mercury, Venus and Mars (within an arcminute); VSOP87D for Jupiter and
# Saturn, terms over 1e-5 (a hundredth of that for each power of time; within 15 arcseconds).
function floor(x) { return x == int(x) || x >= 0 ? int(x) : int(x) - 1 }
function fmod(a, b) { return a - b * floor(a / b) }
function rad(d) { return d * PI / 180 }
function deg(r) { return r * 180 / PI }
function asin(x) { return atan2(x, sqrt(1 - x * x)) }
function acos(x) { return atan2(sqrt(1 - x * x), x) }
function wrap(x) { return fmod(x + 180, 360) - 180 }                 # to -180 .. 180
function cent(t) { return ((t + DT) / 86400 - 10957.5) / 36525 }     # TT centuries from J2000
function out(kind, key, v) { printf "%s %s %.6f\n", kind, key, v }
function outt(key, v) { printf "t %s %d\n", key, (v < 0 ? -1 : int(v + 0.5)) }

# nutation (to 0.5 arcsecond) and true obliquity: DPSI, EPS in degrees
function nut(T,   Om, L, Lp) {
  Om = rad(125.04452 - 1934.136261 * T); L = rad(280.4665 + 36000.7698 * T)
  Lp = rad(218.3165 + 481267.8813 * T)
  DPSI = (-17.20 * sin(Om) - 1.32 * sin(2 * L) - 0.23 * sin(2 * Lp) + 0.21 * sin(2 * Om)) / 3600
  EPS = 23.4392911111 - 0.0130041667 * T - 1.6389e-7 * T * T + 5.0361e-7 * T * T * T \
        + (9.20 * cos(Om) + 0.57 * cos(2 * L) + 0.10 * cos(2 * Lp) - 0.09 * cos(2 * Om)) / 3600
}

# a VSOP87 series of the Earth (as truncated in the Solar Position Algorithm of NREL), at tau
# Julian millennia from J2000 (TT)
function vs(name, tau,   i, s) {
  s = 0
  for (i = 1; i <= VN[name]; i++) s += VA[name, i] * cos(VB[name, i] + VC[name, i] * tau)
  return s
}
# the Sun at t: SL apparent longitude, SRA right ascension (degrees), SDEC declination
# (radians), SE equation of time (minutes), SR distance (AU). The Earth from VSOP87 (about
# 1 arcsecond), then FK5, nutation and aberration as in Meeus ch. 25.
function sun(t,   T, tau, L, B, R, L0, ep, l, b) {
  T = cent(t); tau = T / 10
  earth(tau); L = EL; B = EB; R = ER
  nut(T); SR = R
  SL = fmod(deg(L) + 180 - 0.09033 / 3600 + DPSI - 20.4898 / 3600 / R, 360)
  ep = rad(EPS); l = rad(SL); b = -B
  SRA = fmod(deg(atan2(sin(l) * cos(ep) - sin(b) / cos(b) * sin(ep), cos(l))), 360)
  SDEC = asin(sin(b) * cos(ep) + cos(b) * sin(ep) * sin(l))
  L0 = 280.4664567 + 360007.6982779 * tau + 0.03032028 * tau * tau + tau * tau * tau / 49931 \
       - tau * tau * tau * tau / 15300 - tau * tau * tau * tau * tau / 2000000
  SE = 4 * wrap(L0 - 0.0057183 - SRA + DPSI * cos(ep))
}

# the Earth (VSOP87, heliocentric, ecliptic of date) at tau: EL EB (radians) ER (au)
function earth(tau) {
  EL = (vs("L0", tau) + tau * (vs("L1", tau) + tau * (vs("L2", tau) + tau * (vs("L3", tau) \
        + tau * (vs("L4", tau) + tau * vs("L5", tau)))))) / 1e8
  EB = (vs("B0", tau) + tau * vs("B1", tau)) / 1e8
  ER = (vs("R0", tau) + tau * (vs("R1", tau) + tau * (vs("R2", tau) + tau * (vs("R3", tau) \
        + tau * vs("R4", tau))))) / 1e8
}
# a VSOP87D series of Jupiter or Saturn (p: J or S; x: L, B or R) at tau, all its powers of time
function vp(p, x, tau,   k, s, f) {
  s = 0; f = 1
  for (k = 0; (p x k) in VN; k++) { s += f * vs(p x k, tau); f *= tau }
  return s / 1e8
}
# Jupiter or Saturn (p: J or S) seen from the Earth at t: VSOP87D, light-time, aberration and
# nutation (Meeus ch. 33): the apparent longitude of date (degrees)
function vplon(p, t,   T, tau, ex, ey, ez, lt, i, l, b, r, x, y, z, lam, bet) {
  T = cent(t); tau = T / 10; earth(tau)
  ex = ER * cos(EB) * cos(EL); ey = ER * cos(EB) * sin(EL); ez = ER * sin(EB); lt = 0
  for (i = 0; i < 2; i++) {                  # where it was when its light left it
    l = vp(p, "L", tau - lt / 365250); b = vp(p, "B", tau - lt / 365250); r = vp(p, "R", tau - lt / 365250)
    x = r * cos(b) * cos(l) - ex; y = r * cos(b) * sin(l) - ey; z = r * sin(b) - ez
    lt = 0.0057755183 * sqrt(x * x + y * y + z * z)
  }
  lam = atan2(y, x); bet = atan2(z, sqrt(x * x + y * y)); nut(T)
  return fmod(deg(lam) - 0.09033 / 3600 + DPSI - 20.49552 * cos(EL + PI - lam) / cos(bet) / 3600, 360)
}
# the Moon at t: ML apparent longitude, MB latitude (degrees), MD distance (km), MRA (degrees),
# MDEC (radians), MPAR horizontal parallax (degrees)
function moon(t,   T, Lp, D, M, Mp, F, A1, A2, A3, E, E2, sl, sr, sb, i, a, f, ep, l, b) {
  T = cent(t)
  Lp = 218.3164477 + 481267.88123421 * T - 0.0015786 * T * T + T * T * T / 538841 - T * T * T * T / 65194000
  D = 297.8501921 + 445267.1114034 * T - 0.0018819 * T * T + T * T * T / 545868 - T * T * T * T / 113065000
  M = 357.5291092 + 35999.0502909 * T - 0.0001535 * T * T + T * T * T / 24490000
  Mp = 134.9633964 + 477198.8675055 * T + 0.0087414 * T * T + T * T * T / 69699 - T * T * T * T / 14712000
  F = 93.272095 + 483202.0175233 * T - 0.0036539 * T * T - T * T * T / 3526000 + T * T * T * T / 863310000
  A1 = 119.75 + 131.849 * T; A2 = 53.09 + 479264.29 * T; A3 = 313.45 + 481266.484 * T
  E = 1 - 0.002516 * T - 0.0000074 * T * T; EF[0] = 1; EF[1] = E; EF[2] = E * E
  sl = 3958 * sin(rad(A1)) + 1962 * sin(rad(Lp - F)) + 318 * sin(rad(A2)); sr = 0
  sb = -2235 * sin(rad(Lp)) + 382 * sin(rad(A3)) + 175 * sin(rad(A1 - F)) + 175 * sin(rad(A1 + F)) \
       + 127 * sin(rad(Lp - Mp)) - 115 * sin(rad(Lp + Mp))
  D = rad(fmod(D, 360)); M = rad(fmod(M, 360)); Mp = rad(fmod(Mp, 360)); F = rad(fmod(F, 360))
  for (i = 1; i <= NA; i++) {
    a = AD[i] * D + AM[i] * M + AMp[i] * Mp + AF[i] * F; f = EF[AE[i]]
    sl += AL[i] * f * sin(a); sr += AR[i] * f * cos(a)
  }
  for (i = 1; i <= NB; i++) sb += BB[i] * EF[BE[i]] * sin(BD[i] * D + BM[i] * M + BMp[i] * Mp + BF[i] * F)
  nut(T)
  ML = fmod(Lp + sl / 1e6 + DPSI, 360); MB = sb / 1e6; MD = 385000.56 + sr / 1000
  MPAR = deg(asin(6378.14 / MD))
  ep = rad(EPS); l = rad(ML); b = rad(MB)
  MRA = fmod(deg(atan2(sin(l) * cos(ep) - sin(b) / cos(b) * sin(ep), cos(l))), 360)
  MDEC = asin(sin(b) * cos(ep) + cos(b) * sin(ep) * sin(l))
}

# apparent sidereal time at Greenwich (degrees) for t (UT)
function gast(t,   d, T) {
  d = t / 86400 - 10957.5; T = d / 36525; nut(cent(t))
  return fmod(280.46061837 + 360.98564736629 * d + 0.000387933 * T * T - T * T * T / 38710000 \
              + DPSI * cos(rad(EPS)), 360)
}
# geocentric altitude and azimuth (from north, degrees) of RA ra (degrees), dec (radians) at t
function altaz(t, ra, dec,   H, f) {
  H = rad(gast(t) + LON - ra); f = rad(LAT)
  ALT = deg(asin(sin(f) * sin(dec) + cos(f) * cos(dec) * cos(H)))
  AZ = fmod(deg(atan2(sin(H), cos(H) * sin(f) - sin(dec) / cos(dec) * cos(f))) + 180, 360)
}

# the Sun at altitude h0 on day z (days since 1970, the local date) rising (up 1) or setting
function sunalt(z, h0, up,   t, i, x) {
  t = 12 - LON / 15 + (up ? -6 : 6)                                # hours UT, a first guess
  for (i = 0; i < 5; i++) {
    sun(z * 86400 + t * 3600)
    x = (sin(rad(h0)) - sin(rad(LAT)) * sin(SDEC)) / (cos(rad(LAT)) * cos(SDEC))
    if (x > 1 || x < -1) return -1
    t = 12 - LON / 15 - SE / 60 + (up ? -1 : 1) * deg(acos(x)) / 15
  }
  return z * 86400 + t * 3600
}
# the upper transit of the Sun on day z (anti: the lower transit, solar midnight, after it)
function transit(z, anti,   t, i) {
  t = (anti ? 24 : 12) - LON / 15
  for (i = 0; i < 3; i++) { sun(z * 86400 + t * 3600); t = (anti ? 24 : 12) - LON / 15 - SE / 60 }
  return z * 86400 + t * 3600
}
# the longitude counted in the chosen zodiac: from the equinox, or from Regulus at 0 Leo
function zshift(t) { return ZOD == "regulus" ? 149.8291 + 0.013912 * (t / 86400 - 10957.5) / 365.25 - 120 : 0 }
# when the Sun reaches longitude b (zodiac frame, or tropical when trop) between ta and tb
function sunreach(b, ta, tb, trop,   m) {
  while (tb - ta > 1) {
    m = (ta + tb) / 2; sun(m)
    if (wrap(SL - (trop ? 0 : zshift(m)) - b) < 0) ta = m; else tb = m
  }
  return (ta + tb) / 2
}
# elongation of the Moon from the Sun (degrees, 0 new .. 180 full) and illuminated fraction
function phase(t,   psi, R) {
  sun(t); moon(t)
  ELONG = fmod(ML - SL, 360)
  R = SR * 149597870.7; psi = acos(cos(rad(MB)) * cos(rad(ML - SL)))
  ILLUM = (1 + cos(atan2(R * sin(psi), MD - R * cos(psi)))) / 2
}
# when the elongation reaches b (degrees) between ta and tb
function moonreach(b, ta, tb,   m) {
  while (tb - ta > 1) {
    m = (ta + tb) / 2; phase(m)
    if (wrap(ELONG - b) < 0) ta = m; else tb = m
  }
  return (ta + tb) / 2
}
# the altitude of the Moon above its rising altitude (upper limb on the horizon, with refraction)
function moonup(t) { moon(t); altaz(t, MRA, MDEC); return ALT - (0.7275 * MPAR - 0.5667) }
# planet p around the Sun at T (centuries): HX HY (au, J2000 mean ecliptic). Elements and rates
# from E. M. Standish and J. G. Williams, "Keplerian Elements for Approximate Positions of the
# Major Planets" (JPL), table 1, valid 1800-2050; Kepler's equation by Newton's method.
function helio(p, T,   el, a, e, I, M, w, O, E, dE, x, y) {
  split(PEL[p], el, " ")
  a = el[1] + el[2] * T; e = el[3] + el[4] * T; I = rad(el[5] + el[6] * T)
  w = el[9] + el[10] * T; O = el[11] + el[12] * T
  M = rad(fmod(el[7] + el[8] * T - w, 360)); w = rad(w - O); O = rad(O)
  E = M + e * sin(M); dE = 1
  while (dE > 1e-10 || dE < -1e-10) { dE = (M - E + e * sin(E)) / (1 - e * cos(E)); E += dE }
  x = a * (cos(E) - e); y = a * sqrt(1 - e * e) * sin(E)
  HX = (cos(w) * cos(O) - sin(w) * sin(O) * cos(I)) * x - (sin(w) * cos(O) + cos(w) * sin(O) * cos(I)) * y
  HY = (cos(w) * sin(O) + sin(w) * cos(O) * cos(I)) * x + (cos(w) * cos(O) * cos(I) - sin(w) * sin(O)) * y
}
# planet p seen from the Earth at t: ecliptic longitude of the equinox of date (degrees)
function plon(p, t,   T, x, y) {
  if (p == "Jupiter" || p == "Saturn") return vplon(substr(p, 1, 1), t)
  T = cent(t); helio(p, T); x = HX; y = HY; helio("Earth", T)
  return fmod(deg(atan2(y - HY, x - HX)) + (5028.796195 * T + 1.1054348 * T * T) / 3600, 360)
}
BEGIN {
