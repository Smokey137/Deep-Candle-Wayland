#!/bin/sh
# sound: where the sound goes (right click on the bar's speaker), in fuzzel.
#   sound      pick the output: speakers, headphones, HDMI ...
#   sound in   pick the input: the microphone
# The one in use is marked. Apps that follow the default (most do) move over at once.
# Uses pactl (PipeWire's or PulseAudio's).
kind=sink; word=output
[ "${1:-}" = in ] && kind=source word=input
pactl info >/dev/null 2>&1 || { "$(dirname "$0")/osd" sound volume-muted Sound "no sound server"; exit 1; }
now=$(pactl "get-default-$kind")
list=$(LC_ALL=C pactl list "${kind}s" | awk -v now="$now" '
  /^[[:space:]]*Name: /        { name = $2 }
  /^[[:space:]]*Description: / { d = $0; sub(/^[[:space:]]*Description: /, "", d)
                                 if (name ~ /\.monitor$/) next      # an output seen as an input: not one
                                 printf "%s%s\t%s\n", (name == now) ? "● " : "  ", d, name }')
[ -n "$list" ] || exit 0
i=$(printf '%s\n' "$list" | cut -f1 | fuzzel --dmenu --index --width 56 --prompt "$word ") || exit 0
name=$(printf '%s\n' "$list" | sed -n "$((i + 1))p" | cut -f2)
[ -n "$name" ] && pactl "set-default-$kind" "$name"
