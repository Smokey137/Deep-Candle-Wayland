#!/bin/sh
# sound: the sound mixer, from the bar (a right click on the speaker; on the mic, for its inputs),
# in rofi as the bar's other popups look. The outputs, the apps playing, the inputs, and the apps
# recording from a microphone (so you see who listens), each with its volume and a bar; the
# output and the input in use first in their part, in bold.
#   Outputs and inputs come as you'd pick them: each way out of a sound card a row of its own
#   (Speakers, Headphones, HDMI / DisplayPort; Internal Microphone, a headset's Microphone), by its
#   name, or by the device's when it has only the one (a Bluetooth headset, a USB one); one not
#   plugged in left out. Only the one in use of a card has a volume: the others' come with them
#   (the sound server keeps one for each). A way out that needs the card in another profile (HDMI
#   next to the speakers) gets it on the click; Bluetooth's the sound server switches itself.
#   An app is one row however many streams it opens (a browser one for each tab that plays, a
#   chat one for its calls and one for its sounds): turning it turns them all, and what it plays
#   is next to its name.
#   Mouse   point at a row: the wheel turns it down or up by 5 (with Shift by 1); the middle
#           button mutes or unmutes it; a click makes an output or an input the one in use (what
#           plays, or records from a microphone, goes along), or mutes or unmutes an app.
#   Keys    Up and Down pick a row; Left and Right turn it by 5 (with Shift by 1); 1 to 9 set it
#           to 10 to 90, 0 to 100; m mutes or unmutes; Enter does what a click does; Escape closes.
#   sound in         the same, on the first input (the microphone's right click)
#   sound name out   the name of the output in use (in: the input), as the rows have it, for the
#                    keys' notices (~/.local/bin/volume)
# A device or a recording goes to 100 at most, as the keys; an app to 150 (APPMAX), its bar's
# last five cells gold past 100. Turning an app up stops at 100: past it takes a new turn after a
# pause (HOLD), so a fast swipe or a held key can't take it to 150; 0 puts it back to 100. (The
# sound server keeps an app's volume for its next time, as any other.) A speaker or an app is
# unmuted by any change of its volume, up or down; a microphone or a recording never is. What plays goes along to
# the output in use as a follower of "the one in use" (moved to @DEFAULT_SINK@), never to the
# device by name: unless the server already counts that device as the one in use, such a move
# pins the app to it, and PipeWire keeps the pin per app for good (WirePlumber's state). A move to
# "the one in use" also undoes a pin.
# rofi runs this script again for each turn of the wheel (its script mode), so a turn costs one
# pactl call (one for each stream of an app): the list read from the sound server rides along in
# rofi (its "data") and is read again only when it's over a second old, or after an output or
# input is put in use.
# Uses pactl (PipeWire's or PulseAudio's) and rofi.
ROFI="-theme $HOME/.config/rofi/warm.rasi -m $("$HOME/.local/bin/screen-main") -location 3 -xoffset -10 -yoffset 24"   # under the bar's right side
APPMAX=150      # how far an app may go, in percent (100: no further than the devices)
HOLD=800        # ms: an app turned up stops at 100 while the turns come closer together than this
FILL='#9B59D0' EMPTY='#3A2430' MUTED='#5E4C4A'      # the bar: the icons' amethyst on the pill's plum
BOOST='#F7B922' ZONE='#26171F'                      # an app's 100 to 150: the candle's gold, on the pill
export LC_ALL=C.UTF-8
RS=$(printf '\036') TAB=$(printf '\t') GS=$(printf '\035')

# the list, one record a row, the records apart by RS (\036), the fields by tabs: KIND (out, app,
# in, rec) ID IN-USE MUTED VOLUME (0-100, the mean of its channels; none for a way out not in use)
# NAME MORE (a device's card, when two rows would read the same; what an app plays) IDLE (an app
# paused) STREAMS (an app's, by number). A device's ID is what a click needs, apart by GS (\035):
# the device, the port to switch it to, or the profile to switch the card to, the card and its
# number (the sound server's object.id, as its devices' device.id); an app's is its name. From
# pactl's plain lists: its JSON turns any name that isn't ASCII into "(null)" (PulseAudio 17.0 and
# older). Outputs, apps playing, inputs, apps recording from a microphone; the one in use first
# in its part.
list() {
  { pactl info; pactl list cards; pactl list sinks; pactl list sources; pactl list sink-inputs; pactl list source-outputs; } 2>/dev/null |
  awk -v GS="$GS" '
    function reset() { name = desc = cdesc = mute = monof = class = app = bin = media = aport = client = src = devid = oid = api = aprof = vol = ""; corked = "false"; np = nq = 0; inports = inprofs = 0 }
    function clean(s) { gsub(/[\t\r\035\036\037]/, " ", s); return s }
    function prop(s) { sub(/^[^=]*= "/, "", s); sub(/"$/, "", s); return clean(s) }
    function num(s, k) { return match(s, k "[0-9]+") ? substr(s, RSTART + length(k), RLENGTH - length(k)) + 0 : 0 }
    function put(part, r) { B[part] = B[part] (B[part] == "" ? "" : "\036") r }
    function says(m, who,   t) {  # what an app plays (its own name off its end: "Song - mpv"), unless it says nothing
      t = " - " tolower(who); if (length(m) > length(t) && tolower(substr(m, length(m) - length(t) + 1)) == t) m = substr(m, 1, length(m) - length(t))
      return tolower(m) == tolower(who) || m ~ /^(Playback|AudioStream|Audio Stream|audio stream|playStream|recStream|Simple DirectMedia Layer|record|RecordStream|Capture|capture)?$/ ? "" : m
    }
    function way(c, p,   L, n, j, q, o, i) {   # a card port: out or in, by the profiles it is part of
      n = split(CPP[c, p], L, ", "); o = i = 0
      for (j = 1; j <= n; j++) { q = L[j]; if (CQK[c, q] > 0 && CQS[c, q] == 0) o++; if (CQS[c, q] > 0 && CQK[c, q] == 0) i++ }
      if (o && !i) return "out"
      if (i && !o) return "in"
      return p ~ /^\[Out\]|output/ ? "out" : p ~ /^\[In\]|input/ ? "in" : ""
    }
    function best(c, p, w,   A, Q, L, n, m, j, k, q, other, keep, s, bs, b) {
      # the profile for a port of card c: of the ones it is part of, the one that keeps the other
      # way as it is (HDMI out, the microphone still in), else the one the sound server ranks first
      other = ""; m = split(CAP[c], A, "+")
      for (k = 1; k <= m; k++) if (A[k] ~ (w == "out" ? "^input:" : "^output:")) other = A[k]
      n = split(CPP[c, p], L, ", "); b = ""; bs = -1
      for (j = 1; j <= n; j++) {
        q = L[j]
        if (CQA[c, q] != "yes" || q == "off" || q == "pro-audio" || (w == "out" ? CQK[c, q] : CQS[c, q]) < 1) continue
        keep = 0
        if (other != "") { m = split(q, Q, "+"); for (k = 1; k <= m; k++) if (Q[k] == other) keep = 1 }
        s = keep * 1000000000 + CQP[c, q]
        if (s > bs) { bs = s; b = q }
      }
      return b
    }
    function row(k, id, use, mu, v, port, pdesc, nports, card, own) {   # a way out (or in) to pick
      X[++nx] = k; XI[nx] = id; XU[nx] = use; XM[nx] = mu; XV[nx] = v
      XP[nx] = port; XD[nx] = pdesc; XN[nx] = nports; XC[nx] = card; XO[nx] = own
    }
    function flush(   j, c, g, who, live) {
      if (kind == "card") {
        c = oid != "" ? oid : "#" idx; CARDS[++nc] = c; CN[c] = name; CA[c] = api; CD[c] = cdesc; CAP[c] = aprof
        for (j = 1; j <= nq; j++) { CQK[c, QN[j]] = QK[j]; CQS[c, QN[j]] = QS[j]; CQP[c, QN[j]] = QP[j]; CQA[c, QN[j]] = QA[j] }
        CPN[c] = np; for (j = 1; j <= np; j++) { CP[c, j] = P[j]; CPD[c, P[j]] = PD[j]; CPA[c, P[j]] = PA[j]; CPP[c, P[j]] = PP[j] }
      } else if (kind == "out" || kind == "in") {
        if (kind == "in" && (class == "monitor" || name ~ /\.monitor$/ || (monof != "" && monof != "n/a"))) MON[idx] = 1
        else {
          D[++nd] = kind; DN[nd] = name; DS[nd] = desc != "" ? desc : name; DC[nd] = devid; DM[nd] = mute; DV[nd] = vol; DA[nd] = aport
          DU[nd] = kind == "out" ? name == ds : name == dn
          DPN[nd] = np; for (j = 1; j <= np; j++) { DP[nd, j] = P[j]; DPD[nd, j] = PD[j]; DPA[nd, j] = PA[j]; COV[devid, P[j]] = 1 }
        }
      } else if (kind == "app" || (kind == "rec" && client != "" && client != "n/a" && !(src in MON) && media != "Peak detect")) {
        # (not a recording by the sound server itself, nor of what plays, nor a level meter of a mixer)
        who = app != "" ? app : bin != "" ? bin : "?"; g = kind SUBSEP who
        if (!(g in G)) { G[g] = ++ng; GK[ng] = kind; GW[ng] = who }
        j = G[g]; ST[j] = ST[j] (ST[j] == "" ? "" : " ") idx; GN[j]++
        if (GVA[j] == "" || vol + 0 > GVA[j] + 0) GVA[j] = vol
        if (mute == "true") GMA[j]++
        if (GEA[j] == "") GEA[j] = says(media, who)
        if (corked != "true") {                                   # the streams that play say how it looks
          GL[j]++
          if (GVL[j] == "" || vol + 0 > GVL[j] + 0) GVL[j] = vol
          if (mute == "true") GML[j]++
          if (GEL[j] == "") GEL[j] = says(media, who)
        }
      }
      kind = ""
    }
    /^Default Sink: /   { ds = substr($0, 15); next }
    /^Default Source: / { dn = substr($0, 17); next }
    /^Card #/           { flush(); reset(); kind = "card"; idx = substr($0, 7); next }
    /^Sink #/           { flush(); reset(); kind = "out"; idx = substr($0, 7); next }
    /^Source #/         { flush(); reset(); kind = "in"; idx = substr($0, 9); next }
    /^Sink Input #/     { flush(); reset(); kind = "app"; idx = substr($0, 13); next }
    /^Source Output #/  { flush(); reset(); kind = "rec"; idx = substr($0, 16); next }
    /^\tProfiles:/         { inprofs = 1; next }
    /^\tPorts:/            { inports = 1; next }
    /^\t[^\t]/             { inports = inprofs = 0 }
    /^\tName: /            { name = substr($0, 8); next }
    /^\tDescription: /     { desc = clean(substr($0, 15)); next }
    /^\tMute: /            { mute = $2 == "yes" ? "true" : "false"; next }
    /^\tCorked: /          { corked = $2 == "yes" ? "true" : "false"; next }
    /^\tClient: /          { client = $2; next }
    /^\tSource: /          { src = $2; next }
    /^\tMonitor of Sink: / { monof = substr($0, 19); next }
    /^\tActive Port: /     { aport = substr($0, 15); next }
    /^\tActive Profile: /  { aprof = substr($0, 18); next }
    /^\t\t[^\t]/ && inprofs { p = substr($0, 3); i = index(p, ": "); QN[++nq] = substr(p, 1, i - 1)    # name: what (sinks: 1, sources: 1, priority: 6565, available: yes)
                             QK[nq] = num(p, "sinks: "); QS[nq] = num(p, "sources: "); QP[nq] = num(p, "priority: ")
                             QA[nq] = p ~ /available: no\)$/ ? "no" : "yes"; next }
    /^\t\t[^\t]/ && inports { p = substr($0, 3); i = index(p, ": "); d = substr(p, i + 2); sub(/ \((type|priority):.*$/, "", d)
                             P[++np] = substr(p, 1, i - 1); PD[np] = clean(d); PP[np] = ""
                             PA[np] = p ~ /, not available\)$/ ? "no" : p ~ /, available\)$/ ? "yes" : "unknown"; next }
    /^\t\t\tPart of profile\(s\): / && inports { PP[np] = substr($0, 24); next }
    /^\tVolume: /          { n = sum = 0; v = $0
                             while (match(v, /[0-9]+%/)) { sum += substr(v, RSTART, RLENGTH - 1); n++; v = substr(v, RSTART + RLENGTH) }
                             vol = n ? int(sum / n + 0.5) : ""; next }
    /^\t\tobject\.id = /                 { oid = prop($0); next }
    /^\t\tdevice\.id = /                 { devid = prop($0); next }
    /^\t\tdevice\.api = /                { api = prop($0); next }
    /^\t\tdevice\.description = /        { cdesc = prop($0); next }
    /^\t\tdevice\.class = /              { class = prop($0); next }
    /^\t\tapplication\.name = /          { app = prop($0); next }
    /^\t\tapplication\.process\.binary = / { bin = prop($0); next }
    /^\t\tmedia\.name = /                { media = prop($0); next }
    END {
      flush()
      for (k = 1; k <= nc; k++) { c = CARDS[k]; for (j = 1; j <= CPN[c]; j++) { p = CP[c, j]; W[c, p] = way(c, p); NW[c, W[c, p]]++ } }
      # the devices there are: a row for each of its ports (one not plugged in left out, unless
      # it is the one in use), or the one
      for (n = 1; n <= nd; n++) {
        if (DPN[n] == 0) { row(D[n], DN[n] GS GS GS GS, DU[n], DM[n], DV[n], "", "", 0, DC[n], DS[n]); continue }
        for (j = 1; j <= DPN[n]; j++) {
          p = DP[n, j]; on = p == DA[n]
          if (on) row(D[n], DN[n] GS GS GS GS, DU[n], DM[n], DV[n], p, DPD[n, j], DPN[n], DC[n], DS[n])
          else if (DPA[n, j] != "no") row(D[n], DN[n] GS p GS GS GS, 0, "", "", p, DPD[n, j], DPN[n], DC[n], DS[n])
        }
      }
      # the ways out (and in) of a card that its profile now has no device for
      for (k = 1; k <= nc; k++) {
        c = CARDS[k]; if (CA[c] == "bluez5") continue
        for (j = 1; j <= CPN[c]; j++) {
          p = CP[c, j]
          if ((c, p) in COV || CPA[c, p] == "no" || W[c, p] == "") continue
          q = best(c, p, W[c, p]); if (q == "") continue
          row(W[c, p], GS p GS q GS CN[c] GS c, 0, "", "", p, CPD[c, p], 0, c, CD[c] != "" ? CD[c] : CN[c])
        }
      }
      # their names: the name of the port (Speakers, Headphones) when the card has more than one
      # that way, else of the device; the card next to it when two rows would read the same
      for (x = 1; x <= nx; x++) {
        c = XC[x]
        XT[x] = XP[x] != "" && (XN[x] >= 2 || NW[c, X[x]] >= 2) ? XD[x] : CD[c] != "" ? CD[c] : XO[x]
        SAME[X[x], XT[x]]++
      }
      for (x = 1; x <= nx; x++) {
        more = ""
        if (SAME[X[x], XT[x]] > 1) more = CD[XC[x]] != "" && CD[XC[x]] != XT[x] ? CD[XC[x]] : XO[x]
        put((X[x] == "out" ? 1 : 4) + !XU[x], X[x] "\t" XI[x] "\t" (XU[x] ? "true" : "false") "\t" XM[x] "\t" XV[x] "\t" XT[x] "\t" more "\tfalse\t")
      }
      # the apps: one row each, as its streams that play have it (all of them, when none does)
      for (j = 1; j <= ng; j++) {
        live = GL[j] > 0
        put(GK[j] == "app" ? 3 : 6, GK[j] "\t" GW[j] "\tfalse\t" ((live ? GML[j] == GL[j] : GMA[j] == GN[j]) ? "true" : "false") "\t" \
            (live ? GVL[j] : GVA[j]) "\t" GW[j] "\t" (live ? GEL[j] : GEA[j]) "\t" (live ? "false" : "true") "\t" ST[j])
      }
      s = ""; for (p = 1; p <= 6; p++) if (B[p] != "") s = s (s == "" ? "" : "\036") B[p]; printf "%s", s
    }'
}

# show HEAD LIST [KIND ID VOL MUTED [PICK]]: what rofi gets: its options, the list as its data
# (after HEAD: when it was read, when the last turn came) and the rows: a label column, the volume,
# its bar (spaces in colour, so it lines up in any font; ten cells to 100, an app five more to
# 150), the name; each row's kind and ID as its info. The row KIND ID shows VOL and MUTED instead
# of what the list says (what was just set); PICK selects the first row of its KIND (the one in
# use, just picked). Dim is see-through, as in the clipboard's menu, so it reads on the selected
# row's colour too.
show() {
  T=$1 D=$2 LC_ALL=C awk -v k="${3:-}" -v i="${4:-}" -v v="${5:-}" -v m="${6:-}" -v pick="${7:-}" \
      -v FILL="$FILL" -v EMPTY="$EMPTY" -v MUTED="$MUTED" -v BOOST="$BOOST" -v ZONE="$ZONE" -v APPMAX="$APPMAX" '
    function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
    function dim(s) { return "<span alpha=\"55%\">" s "</span>" }
    function sp(n,   s) { s = ""; while (n-- > 0) s = s " "; return s }
    function cut(s, n, mid,   C, k, j, c, a, o) {  # s in n characters at most (UTF-8): cut at the end,
      k = 0                                         # or in the middle, where devices differ
      for (j = 1; j <= length(s); j++) { c = substr(s, j, 1); if (c ~ /[\200-\277]/ && k) C[k] = C[k] c; else C[++k] = c }
      if (k <= n) return s
      a = mid ? int((n - 1) / 2) : n - 1; o = ""
      for (j = 1; j <= a; j++) o = o C[j]
      o = o "\342\200\246"
      if (mid) for (j = k - (n - 1 - a) + 1; j <= k; j++) o = o C[j]
      return o
    }
    BEGIN {
      n = split(ENVIRON["D"], R, "\036"); data = ENVIRON["T"]; rows = ""; at = ""; shown = 0
      zn = APPMAX > 100 ? int((APPMAX - 100) / 10 + 0.5) : 0      # the cells past 100, for an app
      for (j = 1; j <= n; j++) {
        if (R[j] == "") continue
        nf = split(R[j], f, "\t")
        if (f[1] == k && f[2] == i) {
          if (v != "") f[5] = v
          if (m != "") f[4] = m
          R[j] = f[1]; for (x = 2; x <= nf; x++) R[j] = R[j] "\t" f[x]
        }
        if (pick != "" && at == "" && f[1] == k) at = shown
        data = data "\036" R[j]
        head = f[1] == last ? "" : f[1] == "app" ? "apps" : f[1]; last = f[1]
        if (f[5] == "") { vol = "    "; bar = sp(10 + zn) }       # a way out not in use: no volume of its own yet
        else {
          fl = int(f[5] / 10 + 0.5); if (fl > 10) fl = 10
          bar = "<span background=\x27" (f[4] == "true" ? MUTED : FILL) "\x27>" sp(fl) "</span><span background=\x27" EMPTY "\x27>" sp(10 - fl) "</span>"
          if (f[1] == "app" && zn) {
            bl = int((f[5] - 100) / 10 + 0.5); if (bl < 0) bl = 0; if (bl > zn) bl = zn
            bar = bar "<span background=\x27" (f[4] == "true" ? MUTED : BOOST) "\x27>" sp(bl) "</span><span background=\x27" ZONE "\x27>" sp(zn - bl) "</span>"
          } else bar = bar sp(zn)                                  # the others: blank, so names line up
          vol = sprintf("%3d%%", f[5]); if (f[4] == "true") vol = dim("<s>" vol "</s>")
        }
        app = f[1] == "app" || f[1] == "rec"
        name = esc(cut(f[6], app ? 16 : 30, !app))
        if (f[3] == "true") name = "<b>" name "</b>"
        if (f[8] == "true") name = dim(name)                       # an app paused
        if (f[7] != "") name = name dim("  \302\267  " esc(cut(f[7], app ? 24 : 20, 0)))
        rows = rows sprintf("%s%s %s  %s\0info\037%s\t%s\n", dim(sprintf("%-5s", head)), vol, bar, name, f[1], f[2])
        shown++
      }
      printf "\0markup-rows\037true\n\0no-custom\037true\n\0use-hot-keys\037true\n\0keep-selection\037true\n"
      if (at != "") printf "\0new-selection\037%s\n", at
      printf "\0message\037<span alpha=\"55%%\">wheel, \342\206\220 \342\206\222: volume  \302\267  shift: finer  \302\267  1\342\200\2239, 0: 10\342\200\22390, 100%%&#10;click, enter: use it  \302\267  middle click, m: mute%s</span>\n", zn ? sprintf("&#10;an app goes to %d%%: turning up stops at 100, a new turn goes on", APPMAX) : ""
      printf "\0data\037%s\n", data
      printf "%s", rows
    }'
}

use() {     # use KIND ID: that output (or input) the one in use: its card's profile switched first,
            # when it needs it, then the device's port; what plays (or records from a microphone)
            # along to "the one in use"; a recording of what plays stays where it is
  t=sink; [ "$1" = in ] && t=source
  dev=${2%%"$GS"*} x=${2#*"$GS"}
  port=${x%%"$GS"*} x=${x#*"$GS"}
  prof=${x%%"$GS"*} x=${x#*"$GS"}
  card=${x%%"$GS"*} cid=${x#*"$GS"}
  if [ -n "$prof" ]; then
    pactl set-card-profile "$card" "$prof" || return
    n=0
    while [ -z "$dev" ] && [ $n -lt 30 ]; do      # its device comes a moment later: the card's, with the port
      dev=$(pactl list "${t}s" 2>/dev/null | awk -v cid="$cid" -v port="$port" '
        /^[A-Z]/                              { if (ok && has) exit; name = act = ""; ok = has = 0 }
        /^\tName: /                           { name = substr($0, 8) }
        /^\tActive Port: /                    { act = substr($0, 15) }
        $0 == "\t\tdevice.id = \"" cid "\""   { ok = 1 }
        index($0, "\t\t" port ": ") == 1      { has = 1 }
        END                                   { if (ok && has) print name (act == port ? "\t" : "") }')
      [ -n "$dev" ] || { n=$((n + 1)); sleep 0.1; }
    done
    case $dev in *"$TAB") dev=${dev%"$TAB"} port='' ;; esac   # on that port already
  fi
  [ -n "$dev" ] || return
  [ -n "$port" ] && pactl "set-$t-port" "$dev" "$port"
  if [ "$t" = sink ]; then
    pactl set-default-sink "$dev"
    for s in $(pactl list short sink-inputs 2>/dev/null | cut -f1); do
      pactl move-sink-input "$s" @DEFAULT_SINK@ 2>/dev/null
    done
  else
    pactl set-default-source "$dev"
    mon=" $(pactl list short sources 2>/dev/null | awk -F '\t' '$2 ~ /\.monitor$/ { printf "%s ", $1 }')"
    pactl list short source-outputs 2>/dev/null | cut -f1,2 |
      while read -r s src; do
        case $mon in *" $src "*) ;; *) pactl move-source-output "$s" @DEFAULT_SOURCE@ 2>/dev/null ;; esac
      done
  fi
}

setvol() {  # setvol PERCENT: the row from 0 to 100 (an app to APPMAX, each of its streams); a speaker
            # or an app unmuted too, a mic or a recording not; no call when nothing changes
  top=100; [ "$kind" = app ] && top=$APPMAX
  v=$1; [ "$v" -lt 0 ] && v=0; [ "$v" -gt "$top" ] && v=$top
  case $kind in out|app) [ "$muted" = true ] || [ "$v" != "$vol" ] || return 0 ;; *) [ "$v" != "$vol" ] || return 0 ;; esac
  case $kind in
    out) [ "$muted" = true ] && { pactl set-sink-mute "$dev" 0; m=false; }; pactl set-sink-volume "$dev" "$v%" ;;
    in)  pactl set-source-volume "$dev" "$v%" ;;
    app) for s in $streams; do
           [ "$muted" = true ] && pactl set-sink-input-mute "$s" 0
           pactl set-sink-input-volume "$s" "$v%"
         done
         [ "$muted" = true ] && m=false ;;
    rec) for s in $streams; do pactl set-source-output-volume "$s" "$v%"; done ;;
  esac
}

turnup() {  # turnup PERCENT: setvol, but an app at 100 stays there while the turns keep coming (the
            # last one under HOLD ms ago): past 100 only with a new turn
  if [ "$kind" = app ] && [ "$vol" = 100 ] && [ "$1" -gt 100 ] && [ $((nowms - LAST)) -lt "$HOLD" ]; then
    v=100; return 0
  fi
  setvol "$1"
}

mute() {    # mute: the row muted, or unmuted (an app's streams all alike)
  if [ "$muted" = true ]; then m=false b=0; else m=true b=1; fi
  case $kind in
    out) pactl set-sink-mute "$dev" $b ;;
    in)  pactl set-source-mute "$dev" $b ;;
    app) for s in $streams; do pactl set-sink-input-mute "$s" $b; done ;;
    rec) for s in $streams; do pactl set-source-output-mute "$s" $b; done ;;
  esac
}

# ---- sound name out|in: the name of the one in use
if [ "${1:-}" = name ]; then
  L=$(list) K=${2:-out} LC_ALL=C awk 'BEGIN { n = split(ENVIRON["L"], R, "\036")
    for (j = 1; j <= n; j++) { split(R[j], f, "\t"); if (f[1] == ENVIRON["K"] && f[3] == "true") { print f[6]; exit } } }'
  exit
fi

# ---- the popup: rofi, which runs this script again for its rows and for each key or wheel turn
if [ "${1:-}" != rows ]; then
  if ! pactl info > /dev/null 2>&1; then
    # shellcheck disable=SC2086
    rofi -e "No sound server: pactl can't reach PipeWire or PulseAudio." $ROFI; exit 1
  fi
  sel=0
  [ "${1:-}" = in ] && sel=$(L=$(list) awk 'BEGIN { n = split(ENVIRON["L"], R, "\036"); for (j = 1; j <= n; j++) if (R[j] ~ /^in\t/) { print j - 1; exit } }')
  # the pointer picks the row; the wheel, the middle button, the keys and the digits come to this
  # script (custom keys 1 to 15); a click is Enter
  # shellcheck disable=SC2086
  exec rofi -show sound -modi "sound:'$0' rows" -no-show-icons -selected-row "${sel:-0}" \
       -hover-select -me-select-entry '' -me-accept-entry MousePrimary -ml-row-up '' -ml-row-down '' \
       -kb-move-char-back Control+b -kb-move-char-forward Control+f \
       -kb-mode-previous Control+ISO_Left_Tab -kb-mode-next Control+Tab \
       -kb-custom-1 Left,ScrollDown -kb-custom-2 Right,ScrollUp -kb-custom-3 m,MouseMiddle \
       -kb-custom-4 Shift+Left,Shift+ScrollDown -kb-custom-5 Shift+Right,Shift+ScrollUp \
       -kb-custom-6 1 -kb-custom-7 2 -kb-custom-8 3 -kb-custom-9 4 -kb-custom-10 5 \
       -kb-custom-11 6 -kb-custom-12 7 -kb-custom-13 8 -kb-custom-14 9 -kb-custom-15 0 $ROFI \
       -theme-str 'window { width: 74ch; } mainbox { children: [ message, listview ]; } listview { lines: 18; fixed-height: false; }'
fi

# ---- rofi asks: the list it carries (read again if over a second old: the keys or another app
# may have changed it), what the key or the mouse says done to the row, then the rows
# shellcheck disable=SC3028
case ${EPOCHREALTIME:-} in            # now, in ms: bash's clock (bash is sh on Arch), or date's
  *[.,]*) nowms=${EPOCHREALTIME%[.,]*}${EPOCHREALTIME#*[.,]}; nowms=${nowms%???} ;;
  *)      nowms=$(date +%s%3N) ;;
esac
now=$((nowms / 1000))
case ${ROFI_DATA:-} in                # the data: when the list was read <tab> when the last turn came,
  *"$RS"*) H=${ROFI_DATA%%"$RS"*} L=${ROFI_DATA#*"$RS"} ;;     # then the list
  *)       H='' L='' ;;
esac
T=${H%%"$TAB"*} LAST=${H#*"$TAB"}
case $T in ''|*[!0-9]*) T=0 ;; esac
case $LAST in ''|*[!0-9]*) LAST=0 ;; esac
[ $((now - T)) -le 1 ] || { T=$now; L=$(list); }
kind='' id='' v='' m='' pick=''
r=${ROFI_RETV:-0}
if [ -n "${ROFI_INFO:-}" ] && [ "$r" != 0 ]; then
  kind=${ROFI_INFO%%"$TAB"*} id=${ROFI_INFO#*"$TAB"} vol='' muted='' streams=''
  dev=${id%%"$GS"*}
  x=$RS$L$RS                          # the row's mute, volume and streams, as the list has them (in
  case $x in                          # the shell: this runs for every turn of the wheel)
    *"$RS$kind$TAB$id$TAB"*)
      x=${x#*"$RS$kind$TAB$id$TAB"}; x=${x%%"$RS"*}     # IN-USE MUTED VOLUME NAME MORE IDLE STREAMS
      streams=${x##*"$TAB"}
      x=${x#*"$TAB"}; muted=${x%%"$TAB"*}
      x=${x#*"$TAB"}; vol=${x%%"$TAB"*} ;;
  esac
  case $vol in *[!0-9]*) vol='' ;; esac
  if [ "$r" = 1 ] && { [ "$kind" = out ] || [ "$kind" = in ]; }; then
    use "$kind" "$id"; T=$now L=$(list) pick=1             # read again: it moved to the top of its part
  elif [ -n "$vol" ]; then
    case $r in
      1)  mute ;;
      10) setvol $(( (vol - 1) / 5 * 5 )) ;;      # to the 5 below, as the keys
      11) turnup $(( (vol + 5) / 5 * 5 )) ;;      # to the 5 above
      12) mute ;;
      13) setvol $((vol - 1)) ;;
      14) turnup $((vol + 1)) ;;
      1[5-9]|2[0-3]) setvol $(( (r - 14) * 10 )) ;;   # 1 to 9: 10 to 90
      24) setvol 100 ;;                                # 0: 100
    esac
    case $r in 1[0-9]|2[0-4]) LAST=$nowms ;; esac     # a turn: when, for the stop at 100
  fi
fi
show "$T$TAB$LAST" "$L" "$kind" "$id" "$v" "$m" "$pick"
