#!/bin/sh
# wallpaper: the desktop's picture. With no word, a picker (Super+Alt+W): every
# picture's thumbnail in rofi, the one in use marked; Enter sets it. `wallpaper FILE` sets FILE.
# The choice is ~/.wallpaper, a link to the picture: rhine starts swaybg on that one at login
# (config.rh, startup), so it is still there after the next login. Wayland: swaybg, not feh.
# Pictures come from ~/Pictures/Wallpapers, ~/Pictures/wallpapers and /usr/share/backgrounds;
# their thumbnails are made once (ImageMagick, all cores at a time) and kept in
# ~/.cache/wallpaper-thumbs, named after the picture's path and change time.
DIRS="$HOME/Pictures/Wallpapers $HOME/Pictures/wallpapers /usr/share/backgrounds"
LINK="$HOME/.wallpaper"
THUMBS="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-thumbs"
W=240 H=135   # thumbnail size, px (16:9)

note() { dunstify -u low -h string:x-dunst-stack-tag:wallpaper "Wallpaper" "$1" 2>/dev/null; }
thumb() { printf '%s/%s.png' "$THUMBS" "$(printf '%s %s' "$1" "$(stat -c %Y "$1")" | md5sum | cut -c1-16)"; }

set_it() {   # FILE: link it as ~/.wallpaper and draw it now (as nsxiv's Ctrl+x w does)
  [ -f "$1" ] || { note "No such picture: $1"; exit 1; }
  if [ -e "$LINK" ] && [ ! -L "$LINK" ]; then   # a real file there, not a link: left alone
    note "Not changed: ~/.wallpaper is a file, not a link"; exit 1
  fi
  ln -sfn "$(realpath "$1")" "$LINK" || exit 1
  pkill -x swaybg; setsid -f swaybg -m fill -i "$LINK" >/dev/null 2>&1 </dev/null   # a new one with it
}

if [ "$1" = --thumb ]; then   # (internal) FILE THUMB: make one thumbnail (one it can't read: marked, not tried again)
  magick "$2[0]" -thumbnail "${W}x${H}^" -gravity center -extent "${W}x${H}" "$3" 2>/dev/null || : > "$3.bad"
  exit 0
fi
[ -n "$1" ] && { set_it "$1"; exit; }

list=$(for d in $DIRS; do
  [ -d "$d" ] && find "$d" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \)
done | sort -u)
[ -n "$list" ] || { note "No pictures in ~/Pictures/Wallpapers"; exit 1; }

# the thumbnails still missing: made now, as many at a time as there are cores
mkdir -p "$THUMBS"
todo=$(printf '%s\n' "$list" | while IFS= read -r f; do t=$(thumb "$f"); [ -s "$t" ] || [ -e "$t.bad" ] || printf '%s\n%s\n' "$f" "$t"; done)
if [ -n "$todo" ]; then
  note "Making $(( $(printf '%s\n' "$todo" | wc -l) / 2 )) thumbnails (only this once)…"
  printf '%s\n' "$todo" | tr '\n' '\0' | xargs -0 -n 2 -P "$(nproc)" "$0" --thumb
fi
list=$(printf '%s\n' "$list" | while IFS= read -r f; do [ -e "$(thumb "$f").bad" ] || printf '%s\n' "$f"; done)   # (not pictures after all: left out)

# the picture in use: its place in the list, marked and selected
now=$(realpath "$LINK" 2>/dev/null)
cur=$(printf '%s\n' "$list" | while IFS= read -r f; do realpath "$f"; done | grep -n -x -F "$now" | head -n 1 | cut -d: -f1)
cur=$(( ${cur:-1} - 1 ))

pick=$(printf '%s\n' "$list" | while IFS= read -r f; do
         name=$(basename "$f"); printf '%s\0icon\037%s\n' "${name%.*}" "$(thumb "$f")"
       done | rofi -dmenu -i -p "wallpaper" -show-icons -format i -a "$cur" -selected-row "$cur" \
         -theme "$HOME/.config/rofi/warm.rasi" -m "$("$HOME/.local/bin/screen-main")" \
         -theme-str 'window { width: 860px; } listview { columns: 3; lines: 3; flow: horizontal; }
                     element { orientation: vertical; padding: 8px; }
                     element-icon { size: 150px; horizontal-align: 0.5; }
                     element-text { horizontal-align: 0.5; }
                     element normal.active { text-color: #F7B922; }')
[ -n "$pick" ] || exit 0
set_it "$(printf '%s\n' "$list" | sed -n "$((pick + 1))p")"
