#!/bin/sh
# screenshot (Wayland): Deep Candle's X one uses flameshot, xdotool
# and xrandr; on Wayland grim takes the picture, slurp lets you pick the part, and swappy opens
# it to mark it up (its keys: ~/.config/swappy/config). In swappy: Ctrl+C copies it, Ctrl+S
# keeps it in ~/Pictures/Screenshots, Escape lets it go. Nothing is kept unless you say so.
# Without swappy (Artix has no package of it): the shot is kept in ~/Pictures/Screenshots and
# copied, with a notice that says where.
# usage: screenshot [area|win [GEOMETRY]|now|in5|in10]   no argument: a menu of them
#   area   drag over the part you want        win    the window that has the focus (Ctrl+PrtSc:
#                                                    hyprland.lua gives its GEOMETRY, "X,Y WxH")
#   now    the whole screen                   in5, in10   the whole screen, 5 or 10 seconds on
mkdir -p "$HOME/Pictures/Screenshots"
OSD=$(dirname "$0")/osd
note() { "$OSD" shot camera Screenshot "$1"; }
for c in grim slurp; do
  command -v "$c" >/dev/null || { note "$c isn't installed: sudo pacman -S grim slurp"; exit 1; }
done
shot() {
  if command -v swappy >/dev/null; then grim "$@" - | swappy -f -; return; fi
  f="$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"
  grim "$@" "$f" && wl-copy < "$f" && note "kept and copied: ${f#"$HOME"/}"
}

MODE=${1#--}
if [ -z "$MODE" ]; then
  MODE=$(printf 'area\nwindow\ndesktop\ndelay 5s\n' | \
    fuzzel --dmenu --width 20 --lines 4 --prompt 'shot ')
  sleep 0.3                           # the menu gone from the screen first
fi

case "$MODE" in
  area)            g=$(slurp) || exit 0; shot -g "$g" ;;
  win|window)      # the focused window's place and size: given, else asked of Hyprland
                   g=${2:-}
                   [ -n "$g" ] || g=$(hyprctl -j activewindow 2>/dev/null |
                       jq -r 'select(.at and .size) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' 2>/dev/null)
                   if [ -n "$g" ]; then shot -g "$g"; else g=$(slurp) || exit 0; shot -g "$g"; fi ;;
  now|desktop)     shot ;;
  in5|"delay 5s")  note "in 5 seconds";  sleep 5;  shot ;;
  in10)            note "in 10 seconds"; sleep 10; shot ;;
  *) exit 0 ;;
esac
