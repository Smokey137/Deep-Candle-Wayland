#!/bin/sh
# powermenu (rhine): suspend / logout / reboot / shutdown, in fuzzel.
#   powermenu           pick one (the bar's power button, Super+X)
#   powermenu ACTION    suspend, logout, reboot or shutdown (Ctrl+Alt+Delete: logout)
# Suspend happens at once (it loses nothing); logout, reboot and shutdown ask first.
# Artix: loginctl (elogind) in place of systemctl; logout ends rhine, and river with it.
confirm() {  # yes only if "yes" is picked
  [ "$(printf 'no\nyes\n' | fuzzel --dmenu --index --lines 2 --width 40 --prompt "$1 ")" = 1 ]
}
act() {
  case $1 in
    suspend)  exec loginctl suspend ;;
    logout)   confirm "log out? every window closes" && exec rhinectl rhine exit; exit 0 ;;
    reboot)   confirm "reboot? every window closes" && exec loginctl reboot; exit 0 ;;
    shutdown) confirm "shut down? every window closes" && exec loginctl poweroff; exit 0 ;;
    *)        echo "usage: powermenu [suspend|logout|reboot|shutdown]" >&2; exit 1 ;;
  esac
}
[ $# -gt 0 ] && act "$1"

row() { printf '%s  %s\n' "$(printf "$1")" "$2"; }
choice=$( { row '\357\206\206' suspend; row '\357\202\213' logout
            row '\357\200\241' reboot; row '\357\200\221' shutdown; } \
  | fuzzel --dmenu --index --lines 4 --width 20 --prompt 'power ')
case "$choice" in
  0) act suspend ;;
  1) act logout ;;
  2) act reboot ;;
  3) act shutdown ;;
esac
