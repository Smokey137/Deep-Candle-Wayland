#!/bin/sh
# screen-main (rhine / Wayland): which screen is which. Deep Candle's X one
# asks xrandr; Wayland has no xrandr, so this one reads the kernel's list of screens instead
# (/sys/class/drm). The names are the same ones river and rofi use (eDP-1, HDMI-A-1, ...).
#   screen-main         the main screen: the computer's own panel (eDP, LVDS or DSI), else the
#                       first connected one. Every rofi popup goes there.
#   screen-main ext     the first other connected screen (nothing, and exit 1: none)
#   -p                  taken and ignored (the X one asked the screens again with it)
want=main
[ "${1:-}" = ext ] && want=ext
for s in /sys/class/drm/card*-*/status; do
  [ -e "$s" ] || continue
  [ "$(cat "$s" 2>/dev/null)" = connected ] || continue
  d=${s%/status}; d=${d##*/}; printf '%s\n' "${d#card*-}"
done | awk -v want="$want" '
  { name[++n] = $0; if (own == "" && $0 ~ /^(eDP|LVDS|DSI)/) own = $0 }
  END { main = own != "" ? own : name[1]
        if (want == "main") { if (main == "") exit 1; print main; exit }
        for (i = 1; i <= n; i++) if (name[i] != main) { print name[i]; exit }
        exit 1 }'
