#!/bin/sh
# rhine-session: the Deep Candle session on Wayland, from tty1 (~/.zprofile runs it). What
# ~/.xinitrc did for X: the environment every program of the session gets, a D-Bus session bus
# (no systemd here to give one), then river with rhine as its window manager. When rhine ends
# (power menu -> logout), river ends, this script ends, and you are back at "login:".
# What river and rhine say goes to ~/.local/share/river/session.log, new at each login.

# Wayland for every toolkit that can do it; X apps still work through Xwayland
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM='wayland;xcb'
export SDL_VIDEODRIVER='wayland,x11'
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1        # Java windows stay grey without it
export ADW_DEBUG_COLOR_SCHEME=prefer-dark   # libadwaita apps (Dino): dark, without a settings portal
export XCURSOR_THEME=Qogirr XCURSOR_SIZE=24
export PATH="$HOME/.local/bin:$PATH"

mkdir -p "$HOME/.local/share/river"
exec dbus-run-session river -c rhine </dev/null >"$HOME/.local/share/river/session.log" 2>&1
