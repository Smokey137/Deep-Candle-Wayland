#!/bin/sh
# network: Wi-Fi from the bar (a click on its Wi-Fi), in rofi, as the bar's other popups look.
#   network   the networks in reach, strongest first: the one in use in bold, saved ones marked,
#             open and enterprise ones said so. A click (or Enter) connects; a new secured network
#             asks for its password; on the network in use it shows its address, gateway and DNS.
#             Shift+Delete forgets a saved one. Under them the VPNs (a click turns one on or off;
#             one that needs a password asks for it), then disconnect, rescan, Wi-Fi off or on, and
#             nmtui for the rest: hidden and enterprise networks, fixed addresses, the profiles.
# The pointer picks the row, as in the sound mixer. Connecting goes on after the popup closes, and
# a notice says how it went (~/.local/bin/osd). A password goes to nmcli on its input, never on a
# command line (any process can read those). No nmcli call can hang it: each has a time limit.
# Uses NetworkManager's nmcli, rofi, and kitty for nmtui.
ROFI="-theme $HOME/.config/rofi/warm.rasi -m $("$HOME/.local/bin/screen-main") -location 3 -xoffset -10 -yoffset 24"   # under the bar's right side
OSD=$(dirname "$0")/osd
WAIT=40                         # seconds a connection may take
export LC_ALL=C.UTF-8           # nmcli in English, names as they are (plain C turns é into ?)
nm() { timeout 10 nmcli "$@"; }  # a question to NetworkManager, never waited on for long

esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }      # for Pango markup
note() {    # note ICON TITLE TEXT [MS]: the notice, in place of this popup's last one
  "$OSD" -t "${4:-4000}" network "$1" "$2" "$(esc "$3")" > /dev/null 2>&1
}
why() {     # nmcli's complaint, in a few words
  case $1 in
    *"Secrets were required"*|*"secrets were required"*) echo "wrong password?" ;;
    *"No network with SSID"*)                         echo "it's out of reach" ;;
    *[Tt]imeout*|*"timed out"*|'')                    echo "no answer in $WAIT seconds" ;;
    *) printf '%s\n' "$1" | sed -n 's/^Error: //p' | tail -n 1 | cut -c1-80 ;;
  esac
}

timeout 5 nmcli -t general status > /dev/null 2>&1
case $? in
  0)   ;;
  124) bad="NetworkManager doesn't answer (5 seconds)." ;;
  127) bad="nmcli isn't installed (networkmanager)." ;;
  *)   bad="NetworkManager isn't running." ;;
esac
# shellcheck disable=SC2086
[ -n "${bad:-}" ] && { rofi -e "$bad" $ROFI; exit 1; }
IF=$(nm -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }')
T=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/network.XXXXXX") || exit 1
trap 'rm -rf "$T"' EXIT
trap 'exit 1' INT TERM HUP

saved() {   # each saved Wi-Fi profile: UUID<tab>SSID
  u=$(nm -g UUID,TYPE connection show 2>/dev/null | awk -F: '$2 == "802-11-wireless" { printf "uuid %s ", $1 }')
  [ -n "$u" ] || return 0
  # shellcheck disable=SC2086
  nm -g connection.uuid,802-11-wireless.ssid connection show $u 2>/dev/null |
    awk 'BEGIN { RS = ""; FS = "\n" } { s = $2; gsub(/\\\\/, "\001", s); gsub(/\\:/, ":", s); gsub(/\001/, "\\", s); print $1 "\t" s }'
}
uuids() { saved | W_S=$1 awk -F '\t' '$2 == ENVIRON["W_S"] { print $1 }'; }   # the profiles of SSID $1
# (names go to awk through the environment: -v would read a backslash in one as an escape)
now() {     # is the Wi-Fi on network $1 now?
  nm -t -f ACTIVE,SSID device wifi list ifname "$IF" --rescan no 2>/dev/null | W_WANT=$1 awk '
    BEGIN { want = ENVIRON["W_WANT"] }
    { gsub(/\\\\/, "\001"); gsub(/\\:/, "\002"); split($0, f, ":"); s = f[2]; gsub(/\002/, ":", s); gsub(/\001/, "\\", s)
      if (f[1] == "yes" && s == want) on = 1 }
    END { exit !on }'
}

# ---- the popup's rows ($T/rows, Pango markup), what each does ($T/acts), and its message ($MESG)
build() {
  RADIO=$(nm radio wifi 2>/dev/null)
  { [ -n "$IF" ] && [ "$RADIO" = enabled ] &&
      timeout "$([ "${1:-no}" = yes ] && echo 30 || echo 10)" \
        nmcli -t -f ACTIVE,SIGNAL,SECURITY,FREQ,SSID device wifi list ifname "$IF" --rescan "${1:-no}" 2>/dev/null | sed 's/^/N:/'
    saved | sed 's/^/S\t/'
    nm -t -f NAME,UUID,TYPE,ACTIVE connection show 2>/dev/null | sed 's/^/C:/'
  } | awk -v ROWS="$T/rows" -v ACTS="$T/acts" -v HEAD="$T/head" \
          -v WIFI="$([ -n "$IF" ] && echo "$RADIO")" '
    function terse(s,   n, i) {   # a line of nmcli -t: F[1..n], unescaped
      gsub(/\\\\/, "\001", s); gsub(/\\:/, "\002", s)
      n = split(s, F, ":"); for (i = 1; i <= n; i++) { gsub(/\002/, ":", F[i]); gsub(/\001/, "\\", F[i]) }
      return n
    }
    function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
    function dim(s) { return "<span alpha=\"55%\">" s "</span>" }    # see-through: reads on the selected row too
    function act(row, what) { print row > ROWS; print what > ACTS }
    /^S\t/ { split($0, a, "\t"); if (!(a[3] in SAVED)) SAVED[a[3]] = a[2]; next }
    /^N:/  { terse(substr($0, 3)); s = F[5]
             if (s == "") next                                 # a hidden network
             if (!(s in SIG) || F[2] + 0 > SIG[s]) { SIG[s] = F[2] + 0; SEC[s] = F[3] }
             if (F[1] == "yes") { ON = s; f = F[4] + 0; BAND = f < 3000 ? "2.4 GHz" : f < 5925 ? "5 GHz" : "6 GHz"; ONSEC = F[3] }
             next }
    /^C:/  { terse(substr($0, 3)); if (F[3] == "vpn" || F[3] == "wireguard") { nv++; VN[nv] = F[1]; VU[nv] = F[2]; VA[nv] = F[4] }; next }
    END {
      printf "" > ROWS; printf "" > ACTS
      # the one in use, the saved ones, the rest; each strongest first
      for (s in SIG) { n++; K[n] = s; R[n] = (s == ON ? 2 : (s in SAVED) ? 1 : 0) * 1000 + SIG[s] }
      for (i = 2; i <= n; i++) for (j = i; j > 1 && R[j] > R[j - 1]; j--) {
        t = K[j]; K[j] = K[j - 1]; K[j - 1] = t; t = R[j]; R[j] = R[j - 1]; R[j - 1] = t
      }
      for (i = 1; i <= n; i++) {
        s = K[i]; sec = SEC[s]
        # (OWE, "enhanced open", has no password, though its traffic is encrypted)
        kind = sec ~ /802\.1X/ ? "enterprise" : (sec == "" || sec == "--" || sec ~ /^OWE/) ? "open" : "secured"
        name = s == ON ? "<b>" esc(s) "</b>" : SIG[s] < 25 ? dim(esc(s)) : esc(s)
        tag = s == ON ? "connected" : (s in SAVED) ? "saved" : kind == "secured" ? "" : sec ~ /^OWE/ ? "open, encrypted" : kind
        act(sprintf("%4s  %s%s", SIG[s] "%", name, tag == "" ? "" : dim("  \302\267  " tag)),
            "net\t" s "\t" kind "\t" (s in SAVED ? SAVED[s] : ""))
      }
      for (i = 1; i <= nv; i++)
        act("      " dim("vpn  ") (VA[i] == "yes" ? "<b>" esc(VN[i]) "</b>" dim("  \302\267  on") : esc(VN[i])),
            "vpn\t" VU[i] "\t" VA[i] "\t" VN[i])
      if (ON != "") act("      disconnect", "disconnect\t" ON)
      if (WIFI == "enabled") act("      rescan", "rescan")
      if (WIFI == "enabled") act("      Wi-Fi off", "off")
      else if (WIFI != "") act("      Wi-Fi on", "on")
      act("      more in nmtui", "nmtui")
      print ON "\t" (ON == "" ? "" : SIG[ON]) "\t" BAND "\t" ONSEC > HEAD
    }'
  on=$(cut -f1 "$T/head") sig=$(cut -f2 "$T/head") band=$(cut -f3 "$T/head")
  D="  <span alpha='55%'>·</span>  "
  if [ -z "$IF" ]; then MESG="no Wi-Fi device"
  elif [ "$RADIO" != enabled ]; then MESG="Wi-Fi is off"
  elif [ -n "$on" ]; then
    ip=$(nm -g IP4.ADDRESS device show "$IF" 2>/dev/null | sed 's/ | .*//; s|/.*||')
    MESG="<b>$(esc "$on")</b>$D$sig%${band:+$D$band}${ip:+$D$ip}"
  else MESG="not connected"
  fi
  wired=$(nm -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: '$2 == "ethernet" && $3 == "connected" { print $1; exit }')
  if [ -n "$wired" ]; then
    ip=$(nm -g IP4.ADDRESS device show "$wired" 2>/dev/null | sed 's/ | .*//; s|/.*||')
    MESG="$MESG
wired$D$wired${ip:+$D$ip}"
  fi
  [ -n "$IF" ] && [ "$RADIO" = enabled ] && MESG="$MESG
<span alpha='55%'>click: connect  ·  shift+delete: forget</span>"
}

details() { # the network in use, in full; Escape or a click closes it
  h=$(cat "$T/head")
  nm -t -f IP4.ADDRESS,IP4.GATEWAY,IP4.DNS,IP6.ADDRESS device show "$IF" 2>/dev/null | W_H=$h awk -F '\t' '
    function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
    BEGIN { split(ENVIRON["W_H"], H, "\t"); printf "<b>%s</b>\n", esc(H[1])
            d = "  <span alpha=\"55%%\">\302\267</span>  "
            printf "%s%%" d "%s" d "%s\n", H[2], H[3], H[4] == "" ? "open" : H[4] }
    { k = $0; sub(/:.*/, "", k); v = substr($0, length(k) + 2); sub(/\[[0-9]+\]$/, "", k)
      if (v == "" || v == "--") next
      w = k == "IP4.ADDRESS" ? "address" : k == "IP4.GATEWAY" ? "gateway" : k == "IP4.DNS" ? "DNS" : k == "IP6.ADDRESS" ? "IPv6" : k
      L[w] = (w in L) ? L[w] ", " v : v; if (!(w in SEEN)) { SEEN[w] = 1; O[++n] = w } }
    END { for (i = 1; i <= n; i++) printf "<span alpha=\"55%%\">%-8s</span>%s\n", O[i], esc(L[O[i]]) }' > "$T/details"
  # shellcheck disable=SC2086
  rofi -e "$(cat "$T/details")" -markup $ROFI -theme-str 'window { width: 50ch; }'
}

ask() {     # ask SSID [WHY]: the password typed for SSID; nothing on Escape
  m="password for <b>$(esc "$1")</b>"; [ -n "${2:-}" ] && m="$2
$m"
  # shellcheck disable=SC2086
  rofi -dmenu -password -p password -mesg "$m" $ROFI \
       -theme-str 'window { width: 44ch; } mainbox { children: [ inputbar, message ]; }' < /dev/null
}

# ---- what a row does, once the popup is gone
connect() { # connect SSID PASSWORD (empty: an open network): a network not saved yet
  before=$(uuids "$1")
  note wifi Wi-Fi "connecting to $1" 60000
  if [ -n "$2" ]; then
    out=$(printf '%s\n' "$2" | timeout $((WAIT + 5)) nmcli -w "$WAIT" --ask device wifi connect "$1" ifname "$IF" 2>&1)
  else
    out=$(timeout $((WAIT + 5)) nmcli -w "$WAIT" device wifi connect "$1" ifname "$IF" 2>&1 < /dev/null)
  fi
  if now "$1"; then note wifi Wi-Fi "connected to $1"; return; fi
  for u in $(uuids "$1"); do            # what this attempt saved goes again
    printf '%s\n' "$before" | grep -qx "$u" || nm connection delete uuid "$u" > /dev/null 2>&1
  done
  note wifi-off Wi-Fi "couldn't connect to $1: $(why "$out")"
}

up() {      # up SSID UUID: a saved network; if its saved password fails, a new one is asked for
  note wifi Wi-Fi "connecting to $1" 60000
  out=$(timeout $((WAIT + 5)) nmcli -w "$WAIT" connection up uuid "$2" 2>&1 < /dev/null)
  if now "$1"; then note wifi Wi-Fi "connected to $1"; return; fi
  case $out in
    *"ecrets were required"*)
      pw=$(ask "$1" "the saved password didn't work")
      if [ -z "$pw" ]; then note wifi-off Wi-Fi "not connected to $1"; return; fi
      note wifi Wi-Fi "connecting to $1" 60000
      out=$(printf '%s\n' "$pw" | timeout $((WAIT + 5)) nmcli -w "$WAIT" --ask connection up uuid "$2" 2>&1)
      if now "$1"; then note wifi Wi-Fi "connected to $1"; return; fi ;;
  esac
  note wifi-off Wi-Fi "couldn't connect to $1: $(why "$out")"
}

field() { printf '%s\n' "$1" | cut -f "$2"; }

sel=0
while :; do
  build "${scan:-no}"; scan=no
  n=$(wc -l < "$T/rows")
  [ "$sel" -lt "$n" ] || sel=$((n - 1))
  # shellcheck disable=SC2086
  i=$(rofi -dmenu -markup-rows -i -no-custom -format i -p wifi -mesg "$MESG" -selected-row "$sel" \
        -hover-select -me-select-entry '' -me-accept-entry MousePrimary \
        -kb-delete-entry '' -kb-custom-1 Shift+Delete $ROFI \
        -theme-str 'window { width: 50ch; } listview { lines: 14; fixed-height: false; }' < "$T/rows")
  rc=$?
  case $i in ''|*[!0-9]*) exit 0 ;; esac
  line=$(sed -n "$((i + 1))p" "$T/acts")
  what=$(field "$line" 1)
  if [ "$rc" = 10 ]; then             # Shift+Delete: forget a saved network, and stay
    u=$(field "$line" 4)
    if [ "$what" = net ] && [ -n "$u" ]; then
      nm connection delete uuid "$u" > /dev/null 2>&1 && note wifi-off Wi-Fi "forgot $(field "$line" 2)"
    fi
    sel=$i; continue
  fi
  [ "$rc" = 0 ] || exit 0
  case $what in
    net)
      ssid=$(field "$line" 2) kind=$(field "$line" 3) u=$(field "$line" 4)
      if [ "$ssid" = "$(cut -f1 "$T/head")" ]; then details; exit 0; fi    # in use: its details
      if [ -n "$u" ]; then up "$ssid" "$u"
      elif [ "$kind" = open ]; then connect "$ssid" ""
      elif [ "$kind" = enterprise ]; then
        note wifi-off Wi-Fi "$ssid is an enterprise network: set it up in nmtui"
        setsid -f kitty -e nmtui > /dev/null 2>&1
      else
        pw=$(ask "$ssid")
        [ -n "$pw" ] && connect "$ssid" "$pw"
      fi ;;
    vpn)
      u=$(field "$line" 2) name=$(field "$line" 4)
      if [ "$(field "$line" 3)" = yes ]; then
        if out=$(nm connection down uuid "$u" 2>&1); then note wifi-off VPN "$name off"
        else note wifi-off VPN "$name: $(why "$out")"; fi
      else
        note wifi VPN "$name: connecting" 60000
        if out=$(timeout $((WAIT + 5)) nmcli -w "$WAIT" connection up uuid "$u" 2>&1 < /dev/null); then note wifi VPN "$name on"
        else
          case $out in
            *"ecrets were required"*)              # its password isn't saved: asked for, on nmcli's input
              pw=$(ask "$name" "the VPN needs its password")
              if [ -z "$pw" ]; then note wifi-off VPN "$name: not started"
              elif out=$(printf '%s\n' "$pw" | timeout $((WAIT + 5)) nmcli -w "$WAIT" --ask connection up uuid "$u" 2>&1); then note wifi VPN "$name on"
              else note wifi-off VPN "$name: $(why "$out")"; fi ;;
            *) note wifi-off VPN "$name: $(why "$out")" ;;
          esac
        fi
      fi ;;
    disconnect)
      nm device disconnect "$IF" > /dev/null 2>&1 && note wifi-off Wi-Fi "disconnected from $(field "$line" 2)" ;;
    rescan)
      note wifi Wi-Fi "looking for networks" 8000
      scan=yes; sel=0; continue ;;
    off) nm radio wifi off && note wifi-off Wi-Fi "Wi-Fi off" ;;
    on)  nm radio wifi on && note wifi Wi-Fi "Wi-Fi on" ;;
    nmtui) setsid -f kitty -e nmtui > /dev/null 2>&1 ;;
  esac
  exit 0
done
