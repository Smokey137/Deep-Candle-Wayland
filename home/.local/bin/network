#!/bin/sh
# network: Wi-Fi from the bar (a click on its network piece), in fuzzel.
# The networks in reach, strongest first, the one in use marked; pick one to join it (a saved
# one at once, a new one asks for its password). The first line turns Wi-Fi on or off.
# Uses NetworkManager's nmcli (an [optional] package: without it, this says so and stops).
note() { "$(dirname "$0")/osd" network wifi Wi-Fi "$1"; }
command -v nmcli >/dev/null || { note "needs NetworkManager (nmcli)"; exit 1; }
if [ "$(nmcli radio wifi)" != enabled ]; then
  [ "$(printf 'turn Wi-Fi on\n' | fuzzel --dmenu --index --lines 1 --prompt 'wifi ')" = 0 ] &&
    nmcli radio wifi on
  exit 0
fi
# IN-USE:SIGNAL:SECURITY:SSID, unescaped: only the SSID (last) may hold a colon
list=$(nmcli -t -e no -f IN-USE,SIGNAL,SECURITY,SSID device wifi list 2>/dev/null | awk -F: '
  { ssid = $0; sub(/^[^:]*:[^:]*:[^:]*:/, "", ssid); if (ssid == "" || seen[ssid]++) next
    printf "%s%3s%%  %-5s %s\t%s\n", ($1 == "*") ? "● " : "  ", $2, ($3 == "" || $3 == "--") ? "open" : "lock", ssid, ssid }')
i=$( { printf '  turn Wi-Fi off\n'; printf '%s\n' "$list" | cut -f1; } |
     fuzzel --dmenu --index --no-sort --width 48 --prompt 'wifi ') || exit 0
[ "$i" = 0 ] && { nmcli radio wifi off; exit 0; }
line=$(printf '%s\n' "$list" | sed -n "${i}p")
ssid=$(printf '%s' "$line" | cut -f2)
[ -n "$ssid" ] || exit 0
if nmcli -t -f NAME connection show | grep -qxF "$ssid"; then
  nmcli connection up id "$ssid" >/dev/null 2>&1 && note "joined $ssid" || note "couldn't join $ssid"
elif printf '%s' "$line" | grep -q '% *lock '; then
  pw=$(fuzzel --dmenu --password --prompt-only "password for $ssid ") || exit 0
  nmcli device wifi connect "$ssid" password "$pw" >/dev/null 2>&1 && note "joined $ssid" || note "wrong password, or $ssid is out of reach"
else
  nmcli device wifi connect "$ssid" >/dev/null 2>&1 && note "joined $ssid" || note "couldn't join $ssid"
fi
