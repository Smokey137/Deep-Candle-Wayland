[global]
    monitor = 0
    follow = none

    width = (220, 420)
    height = (0, 300)
    origin = top-right
    offset = (12, 36)
    notification_limit = 5
    indicate_hidden = yes

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 180
    progress_bar_max_width = 392
    progress_bar_corner_radius = 0

    padding = 10
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    gap_size = 6
    separator_height = 1
    separator_color = frame
    corner_radius = 0
    transparency = 0

    font = Iosevka Nerd Font 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    sort = yes
    idle_threshold = 120

    icon_position = left
    min_icon_size = 0
    max_icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = Zafiro

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/rofi -dmenu -p dunst -theme @HOME@/.config/rofi/warm.rasi
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1A1520"
    foreground = "#837868"
    frame_color = "#241D2C"
    highlight = "#B0854E"
    timeout = 3

[urgency_normal]
    background = "#1A1520"
    foreground = "#C4B9A6"
    frame_color = "#241D2C"
    highlight = "#B0854E"
    timeout = 6

[urgency_critical]
    background = "#1A1520"
    foreground = "#C4B9A6"
    frame_color = "#B4675C"
    highlight = "#B4675C"
    timeout = 0
