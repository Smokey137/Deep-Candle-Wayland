/* PCManFM-Qt in Deep Candle, flat like Thunar. Only PCManFM-Qt's and libfm-qt's own widgets are
   named here, so other Qt programs stay as they are. qt6ct reads this file (qt6ct.conf, stylesheets);
   it drops whatever follows two slashes on a line, so there are none in here. */

/* no frames around the panes, no rectangle around the current file */
PCManFM--ViewFrame, Fm--FolderView, Fm--SidePane, Fm--FolderViewTreeView, Fm--FolderViewListView,
Fm--PlacesView, Fm--DirTreeView {
    border: none;
}
Fm--FolderViewTreeView, Fm--FolderViewListView, Fm--PlacesView, Fm--DirTreeView {
    outline: none;
}
Fm--FolderViewTreeView::item:focus, Fm--FolderViewListView::item:focus, Fm--PlacesView::item:focus,
Fm--DirTreeView::item:focus {
    outline: none;   /* the rectangle around the current file is drawn for the item, not the view */
    border: none;
}
Fm--FolderViewTreeView::item:focus:selected, Fm--FolderViewListView::item:focus:selected {
    background-color: palette(highlight);   /* a file clicked (current and selected) keeps the selection's color */
    color: palette(highlighted-text);
}

/* the list of files: one ground under every row, no stripes of two shades. Drawn by the stylesheet
   itself (an item rule), so it holds when qt6ct reloads the stylesheet into running windows; the
   selection's color is given here too, or the rule would hide it on the rows it covers */
Fm--FolderViewTreeView {
    alternate-background-color: palette(base);
}
Fm--FolderViewTreeView::item:alternate {
    background-color: palette(base);
}
Fm--FolderViewTreeView::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

/* the side pane: the place you're in quietly marked, as Thunar does, its name in the clock's gold
   (polybar's YELLOW, #F7B922) */
Fm--PlacesView, Fm--DirTreeView {
    background-color: #140C10;
    selection-background-color: #2B1A23;   /* the whole row, indent included, and the icon's tint */
    selection-color: #F7B922;
}
Fm--PlacesView::item, Fm--DirTreeView::item {
    border: none;
    padding: 3px 2px;
    color: #DCC8AE;
}
Fm--PlacesView::item:hover, Fm--DirTreeView::item:hover {
    background-color: #1E1218;
}
Fm--PlacesView::item:selected, Fm--DirTreeView::item:selected {
    background-color: #2B1A23;
    color: #F7B922;
}
Fm--SidePane QComboBox {
    border: none;
    background-color: transparent;
    color: #8A7470;
    padding: 3px 6px;
}
Fm--SidePane QComboBox:hover {
    color: #DCC8AE;
}
Fm--SidePane QComboBox::drop-down {
    border: none;
    width: 18px;
}
Fm--SidePane QComboBox::down-arrow {
    image: url("@HOME@/.config/qt6ct/qss/deep-candle-down.svg");
    width: 9px;
    height: 9px;
}

/* the toolbar: plain icons; the view in use and the button under the pointer get a quiet ground */
PCManFM--MainWindow QToolBar {
    border: none;
    background-color: transparent;
    spacing: 2px;
}
PCManFM--MainWindow QToolBar QToolButton {
    border: none;
    background-color: transparent;
    border-radius: 6px;
    padding: 4px;
}
PCManFM--MainWindow QToolBar QToolButton:hover {
    background-color: #26171F;
}
PCManFM--MainWindow QToolBar QToolButton:checked {
    background-color: #2B1A23;
}
PCManFM--MainWindow QToolBar QToolButton:pressed {
    background-color: #3A2430;
}
PCManFM--MainWindow QToolBar QToolButton::menu-indicator {
    image: none;
}

/* the path: plain names, the folder you're in as a pill, as in Thunar; the pill wears the side pane's
   mark, plum with the name in gold, so both say "you are here" alike */
PCManFM--MainWindow QToolBar Fm--PathBar QToolButton {
    border: none;
    background-color: transparent;
    color: #8A7470;
    border-radius: 11px;
    padding: 3px 10px;
}
PCManFM--MainWindow QToolBar Fm--PathBar QToolButton:hover {
    background-color: #26171F;
    color: #DCC8AE;
}
PCManFM--MainWindow QToolBar Fm--PathBar QToolButton:checked {
    background-color: #2B1A23;
    color: #F7B922;
}

/* the column titles: text only */
Fm--FolderViewTreeView QHeaderView {
    background-color: transparent;
    border: none;
}
Fm--FolderViewTreeView QHeaderView::section {
    background-color: transparent;
    color: #8A7470;
    border: none;
    padding: 3px 6px;
}
Fm--FolderViewTreeView QHeaderView::section:hover {
    color: #DCC8AE;
}
Fm--FolderViewTreeView QHeaderView::up-arrow {
    image: url("@HOME@/.config/qt6ct/qss/deep-candle-down.svg");   /* Qt asks for up-arrow when A comes first; Thunar points down there */
    width: 9px;
    height: 9px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    margin-right: 8px;
}
Fm--FolderViewTreeView QHeaderView::down-arrow {
    image: url("@HOME@/.config/qt6ct/qss/deep-candle-up.svg");
    width: 9px;
    height: 9px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    margin-right: 8px;
}

/* thin scroll bars, no arrow buttons */
Fm--FolderViewTreeView QScrollBar, Fm--FolderViewListView QScrollBar, Fm--PlacesView QScrollBar,
Fm--DirTreeView QScrollBar {
    background-color: transparent;
    border: none;
    margin: 0;
}
Fm--FolderViewTreeView QScrollBar:vertical, Fm--FolderViewListView QScrollBar:vertical,
Fm--PlacesView QScrollBar:vertical, Fm--DirTreeView QScrollBar:vertical {
    width: 8px;
}
Fm--FolderViewTreeView QScrollBar:horizontal, Fm--FolderViewListView QScrollBar:horizontal,
Fm--PlacesView QScrollBar:horizontal, Fm--DirTreeView QScrollBar:horizontal {
    height: 8px;
}
Fm--FolderViewTreeView QScrollBar::handle, Fm--FolderViewListView QScrollBar::handle,
Fm--PlacesView QScrollBar::handle, Fm--DirTreeView QScrollBar::handle {
    background-color: #3A2430;
    border-radius: 4px;
    min-height: 32px;
    min-width: 32px;
}
Fm--FolderViewTreeView QScrollBar::handle:hover, Fm--FolderViewListView QScrollBar::handle:hover,
Fm--PlacesView QScrollBar::handle:hover, Fm--DirTreeView QScrollBar::handle:hover {
    background-color: #4A3040;
}
Fm--FolderViewTreeView QScrollBar::add-line, Fm--FolderViewTreeView QScrollBar::sub-line,
Fm--FolderViewListView QScrollBar::add-line, Fm--FolderViewListView QScrollBar::sub-line,
Fm--PlacesView QScrollBar::add-line, Fm--PlacesView QScrollBar::sub-line,
Fm--DirTreeView QScrollBar::add-line, Fm--DirTreeView QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}
Fm--FolderViewTreeView QScrollBar::add-page, Fm--FolderViewTreeView QScrollBar::sub-page,
Fm--FolderViewListView QScrollBar::add-page, Fm--FolderViewListView QScrollBar::sub-page,
Fm--PlacesView QScrollBar::add-page, Fm--PlacesView QScrollBar::sub-page,
Fm--DirTreeView QScrollBar::add-page, Fm--DirTreeView QScrollBar::sub-page {
    background: none;
}

/* tabs (with two or more open): a line under the one shown, no boxes; it and its name in gold, the
   mark for where you are */
PCManFM--MainWindow QTabBar::tab {
    border: none;
    background-color: transparent;
    color: #8A7470;
    padding: 4px 12px;
}
PCManFM--MainWindow QTabBar::tab:hover {
    color: #DCC8AE;
}
PCManFM--MainWindow QTabBar::tab:selected {
    color: #F7B922;
    border-bottom: 2px solid #F7B922;
}

/* the divider between the side pane and the files, and the status bar: no grips, no boxes */
PCManFM--MainWindow QSplitter::handle {
    background-color: transparent;
    image: none;
}
PCManFM--MainWindow QStatusBar {
    border: none;
    color: #8A7470;
}
PCManFM--MainWindow QStatusBar::item {
    border: none;
}
