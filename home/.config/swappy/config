# swappy, the screenshot marker, for a shot opened by hand (swappy -f FILE; ~/.local/bin/screenshot
# itself uses flameshot): your
# screenshots' folder, your gold as its own colour (C), boxes to start with. Keys: r box, a arrow,
# t text, b brush, d blur; R G B C colours; - + size; Ctrl+z undo; Escape or q closes, the shot
# kept as marked and copied.
[Default]
save_dir=$HOME/Pictures/Screenshots
save_filename_format=%Y-%m-%d_%H-%M-%S-marked.png
show_panel=true
line_size=4
text_size=18
text_font=sans-serif
paint_mode=rectangle
early_exit=false
fill_shape=false
auto_save=false
custom_color=#F7B922
transparent=false
transparency=50
