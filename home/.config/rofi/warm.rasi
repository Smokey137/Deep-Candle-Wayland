* {
    bg:     #140C10;
    bg-alt: #9B59D0;
    edge:   #453937;
    fg:     #DCC8AE;
    fg-dim: #8A7470;
    accent: #C50ED2;
    on-accent: #FFF2E6;

    background-color: transparent;
    text-color:       @fg;
    font:             "Monospace 11";
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @edge;
    border-radius:    8px;
    padding:          14px;
    width:            640px;
}

mainbox {
    spacing:  12px;
}

inputbar {
    children: [ prompt, entry ];
    spacing:  8px;
}

prompt { text-color: @accent; }
entry  { placeholder: ""; }

listview {
    lines:   5;
    spacing: 2px;
}

element { padding: 5px 10px; border-radius: 6px; }

element selected {
    text-color:       @on-accent;
    background-color: @accent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

textbox {
    text-color: @fg;
    padding:    4px;
}

error-message {
    background-color: @bg;
    padding:          14px;
}

/* Deep Candle glass: see-through popups (needs picom); text and the selection stay solid */
window        { background-color: #140C10D9; }
error-message { background-color: transparent; }
