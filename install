#!/usr/bin/env bash
# install: put Deep Candle Hyprland onto this computer.
#
#   ./install             everything below; a file it changes is kept first as <file>.bak-YYYYMMDD
#   ./install --dry-run   only show what would change
#
#   home/        -> ~                                   Hyprland's settings, the bar, the launcher, their scripts
#   fonts/       -> ~/.local/share/fonts/deep-candle/   (fonts/mass-driver/ -> .../mass-driver/)
#   wallpaper/   -> ~/Pictures/Wallpapers/              and ~/.wallpaper points to it
# It does not install programs (packages.txt) and never uses sudo: what needs it, it prints.
set -euo pipefail
repo=$(cd "$(dirname "$0")" && pwd)
cd "$repo"
dry=0
for a; do
  case $a in
    --dry-run) dry=1 ;;
    *) echo "usage: ./install [--dry-run]" >&2; exit 1 ;;
  esac
done
stamp=$(date +%Y%m%d)
changed=0

put() {   # put SOURCE DEST: copy, with @HOME@ made into this home folder
  local src=$1 dest=$2 tmp
  tmp=$(mktemp)
  if grep -qF '@HOME@' "$src" 2>/dev/null; then
    sed "s|@HOME@|$HOME|g" "$src" > "$tmp"; chmod --reference="$src" "$tmp"
  else
    cp -p "$src" "$tmp"
  fi
  if [ -e "$dest" ] && cmp -s "$tmp" "$dest"; then rm -f "$tmp"; return; fi
  changed=$((changed + 1))
  if [ "$dry" = 1 ]; then
    if [ -e "$dest" ]; then echo "  would change: ${dest/#$HOME/\~}"; else echo "  would add:    ${dest/#$HOME/\~}"; fi
    rm -f "$tmp"; return
  fi
  mkdir -p "$(dirname "$dest")"
  [ -e "$dest" ] && cp -p "$dest" "$dest.bak-$stamp"
  mv "$tmp" "$dest"
  echo "  ${dest/#$HOME/\~}"
}

echo "== your files (home/ -> ~)"
while IFS= read -r -d '' f; do put "$f" "$HOME/${f#home/}"; done < <(find home -type f -print0 | sort -z)

echo "== fonts (-> ~/.local/share/fonts/deep-candle and .../mass-driver)"
for f in fonts/*.ttf fonts/LICENSE-OFL.txt; do [ -e "$f" ] && put "$f" "$HOME/.local/share/fonts/deep-candle/${f#fonts/}"; done
for f in fonts/mass-driver/*; do [ -e "$f" ] && put "$f" "$HOME/.local/share/fonts/mass-driver/${f#fonts/mass-driver/}"; done
[ "$dry" = 0 ] && command -v fc-cache >/dev/null && fc-cache -f >/dev/null 2>&1 || true

echo "== wallpaper (-> ~/Pictures/Wallpapers, ~/.wallpaper points to it)"
for f in wallpaper/*; do
  [ -e "$f" ] || continue
  put "$f" "$HOME/Pictures/Wallpapers/${f#wallpaper/}"
  if [ ! -e "$HOME/.wallpaper" ] && [ ! -L "$HOME/.wallpaper" ]; then
    if [ "$dry" = 1 ]; then echo "  would link: ~/.wallpaper"; else ln -s "$HOME/Pictures/Wallpapers/${f#wallpaper/}" "$HOME/.wallpaper"; echo "  ~/.wallpaper"; fi
  fi
done

if [ "$dry" = 1 ]; then echo; echo "$changed file(s) would change. Nothing was changed."; exit 0; fi
cat <<EOF

Done ($changed file(s) changed; old ones kept as *.bak-$stamp).

By hand, once:
  video    brightness keys: sudo usermod -aG video ${USER:-$(id -un)}
Then log out, and log in on tty1: hyprland-session starts Hyprland.
EOF

# left from this repo's river + rhine days: nothing uses them now. Named, never removed here.
old=
for f in "$HOME/.config/river" "$HOME/.local/bin/rhine-session" "$HOME/.local/bin/runner" "$HOME/.local/bin/ob-colorpicker"; do
  [ -e "$f" ] && old="$old ${f/#$HOME/\~}"
done
[ -z "$old" ] || printf '\nFrom the river version, no longer used (yours to delete):%s\n' "$old"
